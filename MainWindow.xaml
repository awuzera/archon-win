                                        <Ellipse Canvas.Left="23.5" Canvas.Top="18.5" Width="5" Height="5" Fill="#93C5FD"/>
                                        <Ellipse Canvas.Left="83.5" Canvas.Top="18.5" Width="5" Height="5" Fill="#93C5FD"/>

                                        <!-- Patas medio-delanteras -->
                                        <Path Data="M43,49 L18,39 L7,28 M69,49 L94,39 L105,28"
                                              Stroke="#3B82F6" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <Ellipse Canvas.Left="15.5" Canvas.Top="36.5" Width="5" Height="5" Fill="#93C5FD"/>
                                        <Ellipse Canvas.Left="91.5" Canvas.Top="36.5" Width="5" Height="5" Fill="#93C5FD"/>

                                        <!-- Patas medio-traseras -->
                                        <Path Data="M43,59 L18,69 L7,82 M69,59 L94,69 L105,82"
                                              Stroke="#3B82F6" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <Ellipse Canvas.Left="15.5" Canvas.Top="66.5" Width="5" Height="5" Fill="#93C5FD"/>
                                        <Ellipse Canvas.Left="91.5" Canvas.Top="66.5" Width="5" Height="5" Fill="#93C5FD"/>

                                        <!-- Patas traseras -->
                                        <Path Data="M47,67 L27,88 L17,102 M65,67 L85,88 L95,102"
                                              Stroke="#3B82F6" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <Ellipse Canvas.Left="24.5" Canvas.Top="85.5" Width="5" Height="5" Fill="#93C5FD"/>
                                        <Ellipse Canvas.Left="82.5" Canvas.Top="85.5" Width="5" Height="5" Fill="#93C5FD"/>

                                        <!-- Quelíceros frontales -->
                                        <Path Data="M51,26 L49,17 M61,26 L63,17" Stroke="#60A5FA" StrokeThickness="2.4" StrokeStartLineCap="Round"/>

                                        <!-- Cefalotórax facetado -->
                                        <Polygon Points="56,24 67,37 56,49 45,37" Fill="#FFFFFF"/>
                                        <Polygon Points="56,28 62,37 56,45 50,37" Fill="#DBEAFE"/>

                                        <!-- Abdomen blindado -->
                                        <Polygon Points="56,49 73,69 56,92 39,69" Fill="#0F254A" Stroke="#FFFFFF" StrokeThickness="2.6" StrokeLineJoin="Round"/>
                                        <!-- Núcleo energético dorsal -->
                                        <Polygon Points="56,57 63,69 56,81 49,69" Fill="#3B82F6"/>
                                        <Polygon Points="56,63 59,69 56,75 53,69" Fill="#FFFFFF"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <TextBlock Text="Archon" FontSize="44" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,2"/>

