                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 3 BOTONES PRINCIPALES (COMENZAR, VER MIS COMPONENTES, RENDIMIENTO) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
