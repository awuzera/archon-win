<Window x:Class="Archon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCHON v1.0"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#07070A"
        Foreground="#F5F5F8"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0" CornerRadius="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="BgCardBlack" Color="#090A0F"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#11141E"/>
        <SolidColorBrush x:Key="BorderDark" Color="#1C1F2B"/>
        <SolidColorBrush x:Key="BorderHover" Color="#2F4263"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#1B4985"/>
        <SolidColorBrush x:Key="AccentPrimaryHover" Color="#2359A1"/>
        <SolidColorBrush x:Key="AccentLine" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#D4D6E0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A6ACBE"/>

        <!-- ILUMINACIÓN AMBIENTAL DE FONDO MÁS VISIBLE Y FLUIDA -->
        <Storyboard x:Key="AmbientGlowStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="AuroraTopTransform"
                             Storyboard.TargetProperty="X"
                             From="-170" To="170" Duration="0:0:11" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuroraTop"
                             Storyboard.TargetProperty="Opacity"
                             From="0.72" To="1.0" Duration="0:0:6.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="AuroraCenterTransform"
                             Storyboard.TargetProperty="Y"
                             From="-55" To="55" Duration="0:0:9" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuroraCenter"
                             Storyboard.TargetProperty="Opacity"
                             From="0.55" To="0.95" Duration="0:0:7.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="AuroraBottomTransform"
                             Storyboard.TargetProperty="X"
                             From="160" To="-160" Duration="0:0:13" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuroraBottom"
                             Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.60" Duration="0:0:8" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ANIMACIÓN DOBLE ANILLO PARA CARGA -->
        <Storyboard x:Key="LoadingRingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoadingRingRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:2.1"/>
            <DoubleAnimation Storyboard.TargetName="LoadingInnerRingRotate"
                             Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:3.2"/>
        </Storyboard>

        <!-- SCROLLBAR ANCHO Y SEPARADO -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,2,0,2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#282B38" CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#3D4357"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BARRA DE PROGRESO REDONDEADA -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#151822"/>
            <Setter Property="Foreground" Value="#2D6EC2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTONES DE VENTANA -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A8A8B6"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14161F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B82D35"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN PRINCIPAL CON ACABADO TRANSLÚCIDO Y BRILLO SUTIL (NO SÓLIDO PLANO) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="26,13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" BorderBrush="#3B79CC" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#CC235EB0" Offset="0.0"/>
                                    <GradientStop Color="#D9163E78" Offset="0.55"/>
                                    <GradientStop Color="#E6102F5C" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5C9BF0"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#E02D6EC9" Offset="0.0"/>
                                            <GradientStop Color="#EB1D4E94" Offset="0.55"/>
                                            <GradientStop Color="#F2153B73" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PANEL / BOTÓN OSCURO DE SUPERFICIE -->
        <Style x:Key="SoftCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#B80B0D14"/>
            <Setter Property="Foreground" Value="#F5F5F8"/>
            <Setter Property="Padding" Value="22,15"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderDark}" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D9131724"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BLOQUE DE OPCIÓN UNIFORME PARA PREPARACIÓN -->
        <Style x:Key="PrepOptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCardBlack}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="Foreground" Value="#F5F5F8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Border x:Name="LeftAccent" Width="3" HorizontalAlignment="Left" CornerRadius="6,0,0,6" Background="Transparent"/>
                                <Border Padding="28,22">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource BgCardHover}"/>
                                <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                                <Setter TargetName="LeftAccent" Property="Background" Value="#2D6EC2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RowBg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN DE NAVEGACIÓN DISCRETO -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#141620"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SWITCH LIMPIO -->
        <Style x:Key="ModernSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="46" Height="24" CornerRadius="5" Background="#1D1F2A">
                            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="3" Margin="3,0" HorizontalAlignment="Left" Background="#9A9AA8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentPrimary}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1A1C26" BorderThickness="1" CornerRadius="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#06070B" Offset="0"/>
                <GradientStop Color="#090D17" Offset="0.5"/>
                <GradientStop Color="#06070B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR CON NUEVO EMBLEMA AERODINÁMICO -->
            <Border Grid.Row="0" Background="#050507" BorderBrush="#12141C" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <Viewbox Width="22" Height="22" Margin="0,0,10,0">
                            <Canvas Width="64" Height="64">
                                <Path Data="M10,50 C14,26 26,12 32,8 C38,12 50,26 54,50 C44,41 38,38 32,38 C26,38 20,41 10,50 Z"
                                      Fill="#13294B" Stroke="#3B82F6" StrokeThickness="3.2" StrokeLineJoin="Round"/>
                                <Path Data="M20,46 L32,20 L44,46"
                                      Stroke="#FFFFFF" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Ellipse Canvas.Left="28.5" Canvas.Top="45" Width="7" Height="7" Fill="#3B82F6"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Archon" FontWeight="SemiBold" FontSize="15" Foreground="#F5F5F8" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.0" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Style="{StaticResource WindowControlButtonStyle}" Click="Minimize_Click"/>
                        <Button Content="✕" Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENEDOR PRINCIPAL -->
            <Grid Grid.Row="1">

                <!-- ILUMINACIÓN AMBIENTAL DE FONDO MÁS VISIBLE -->
                <Grid x:Name="AmbientGlowLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="AuroraTop" Width="1560" Height="720" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-140,-180,-140,0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AuroraTopTransform" X="0" Y="0"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.58" RadiusY="0.68">
                                <GradientStop Color="#661D57A6" Offset="0.0"/>
                                <GradientStop Color="#3B184585" Offset="0.36"/>
                                <GradientStop Color="#1611305E" Offset="0.70"/>
                                <GradientStop Color="#0011305E" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle x:Name="AuroraCenter" Width="1200" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AuroraCenterTransform" X="0" Y="0"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.52" RadiusY="0.55">
                                <GradientStop Color="#382563EB" Offset="0.0"/>
                                <GradientStop Color="#1A1B4985" Offset="0.45"/>
                                <GradientStop Color="#001B4985" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle x:Name="AuroraBottom" Width="1560" Height="700" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-140,0,-140,-210">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AuroraBottomTransform" X="0" Y="0"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.65" GradientOrigin="0.5,0.65" RadiusX="0.60" RadiusY="0.68">
                                <GradientStop Color="#5219498A" Offset="0.0"/>
                                <GradientStop Color="#2B143A6E" Offset="0.42"/>
                                <GradientStop Color="#100F2A52" Offset="0.74"/>
                                <GradientStop Color="#000F2A52" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- VISTA 1: PRESENTACIÓN -->
                <ScrollViewer x:Name="WelcomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="WelcomeContentPanel" MaxWidth="820" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,16,32,36">
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>

                        <!-- NUEVO EMBLEMA AERODINÁMICO DE ARCHON -->
                        <Border x:Name="WelcomeLogoContainer" Width="92" Height="92" HorizontalAlignment="Center" Margin="0,0,0,6" Background="Transparent" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Viewbox Width="88" Height="88">
                                <Canvas Width="96" Height="96">
                                    <!-- Halo orbital sutil -->
                                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="80" Height="80" Stroke="#1D355E" StrokeThickness="1.3"/>
                                    <!-- Silueta principal de doble ala ascendente -->
                                    <Path Data="M16,74 C21,39 38,18 48,12 C58,18 75,39 80,74 C65,61 56,56 48,56 C40,56 31,61 16,74 Z"
                                          Stroke="#3B82F6" StrokeThickness="2.6" StrokeLineJoin="Round">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#2B4B8CE0" Offset="0.0"/>
                                                <GradientStop Color="#1214284D" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>
                                    <!-- Trazo interno de precisión -->
                                    <Path Data="M30,66 L48,29 L66,66"
                                          Stroke="#FFFFFF" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <!-- Puente transversal sutil -->
                                    <Path Data="M36,53 C42,49 54,49 60,53"
                                          Stroke="#6CA6F0" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <!-- Nodo central luminoso -->
                                    <Ellipse Canvas.Left="43" Canvas.Top="64" Width="10" Height="10" Fill="#1B4985" Stroke="#5D9BE6" StrokeThickness="1.6"/>
                                    <Ellipse Canvas.Left="46.2" Canvas.Top="67.2" Width="3.6" Height="3.6" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="Archon" FontSize="44" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                        <TextBlock Text="Bienvenido" FontSize="18.5" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <!-- BOTONES PRINCIPALES -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,28">
                            <Button x:Name="BtnStartStepZero" Style="{StaticResource PrimaryButtonStyle}" Padding="36,14" Margin="0,0,14,0" Click="BtnStartStepZero_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Comenzar" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="10,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnScanHardware" Style="{StaticResource SoftCardButtonStyle}" Padding="24,14" Click="BtnScanHardware_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M9,2 V5 M15,2 V5 M9,19 V22 M15,19 V22 M2,9 H5 M2,15 H5 M19,9 H22 M19,15 H22 M6,5 H18 A1,1 0 0 1 19,6 V18 A1,1 0 0 1 18,19 H6 A1,1 0 0 1 5,18 V6 A1,1 0 0 1 6,5 Z M9,9 H15 V15 H9 Z"
                                          Stroke="#E2E5F0" StrokeThickness="1.7" Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtScanButtonLabel" Text="Ver mis componentes" FontSize="15.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- PANEL INTERACTIVO DE HARDWARE CON ETIQUETAS MÁS RESALTADAS -->
                        <Border x:Name="HardwareListPanel" Visibility="Collapsed" MinWidth="660" Background="#CC090A0F"
                                BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="7" Padding="26,22">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Componentes detectados" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                    <Button Grid.Column="1" x:Name="BtnViewAllHardware" Style="{StaticResource GhostButtonStyle}" Padding="10,5" Click="BtnViewAllHardware_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Ver más" FontSize="14.5" FontWeight="SemiBold" Foreground="#5D9BE6" VerticalAlignment="Center"/>
                                            <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#5D9BE6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" Margin="6,1,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Procesador" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtCpuValue" Text="Detectando..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                                <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Placa madre" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtMotherValue" Text="Detectando..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                                <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tarjeta gráfica" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtGpuValue" Text="Detectando..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                                <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Memoria RAM" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtRamValue" Text="Detectando..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                                <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Almacenamiento" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtStorageValue" Text="Detectando..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                                <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sistema operativo" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtOsValue" Text="Detectando..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VISTA 1B: INVENTARIO COMPLETO DE HARDWARE ("VER MÁS") CON LETRA MÁS GRANDE Y CLARA -->
                <ScrollViewer x:Name="FullHardwareView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FullHardwareContainer" Width="1080" HorizontalAlignment="Center" Margin="28,18,28,48">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="FullHardwareSlideTransform" Y="0"/>
                        </StackPanel.RenderTransform>

                        <Button x:Name="BtnBackFromFullHardware" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="-10,0,0,14" Click="BtnBackFromFullHardware_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19,12 L5,12 M11,6 L5,12 L11,18"
                                      Stroke="#E4E7F2" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Volver al inicio" FontSize="15" FontWeight="Medium" Foreground="#EEF1FA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="Especificaciones completas del equipo" FontSize="29" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                        <TextBlock Text="Inventario detallado de hardware, estado de TPM 2.0 y opciones de BIOS para gaming, memoria, discos, red y entorno de Windows."
                                   FontSize="16" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,24"/>

                        <ItemsControl x:Name="FullHardwareSectionsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#D9090A0F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="7" Padding="26,20" Margin="0,0,0,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                <Border Width="4" Height="18" CornerRadius="2" Background="#3B82F6" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SectionTitle}" FontSize="18.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Specs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#161924" BorderThickness="0,0,0,1" Padding="0,12">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="310"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="16" FontWeight="Medium" Foreground="#CED5E6" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="16.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- VISTA 2: PREPARACIÓN DEL SISTEMA -->
                <ScrollViewer x:Name="StepZeroView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Effect>
                        <BlurEffect x:Name="StepZeroBlur" Radius="0"/>
                    </ScrollViewer.Effect>

                    <StackPanel Width="1080" HorizontalAlignment="Center" Margin="28,18,28,48">

                        <!-- BOTÓN INICIO -->
                        <Button x:Name="BtnBackToWelcome" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="-10,0,0,14" Click="BtnBackToWelcome_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,10.5 L12,3 L21,10.5 V20 A1,1 0 0 1 20,21 H15 V14 H9 V21 H4 A1,1 0 0 1 3,20 Z"
                                      Stroke="#D0D0DA" StrokeThickness="1.7" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Inicio" FontSize="14.5" FontWeight="Medium" Foreground="#E4E4EC" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ENCABEZADO -->
                        <TextBlock Text="Preparación del sistema" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>

                        <TextBlock Text="Elegí el estado actual de tu Windows para preparar los controladores antes de pasar al panel de ajustes."
                                   FontSize="16" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,24"/>

                        <!-- AVISO DE BLOATWARE DETECTADO -->
                        <Border x:Name="BloatAlertBox" Visibility="Collapsed" Background="#0C111C" BorderBrush="#23334F" BorderThickness="1" CornerRadius="6" Padding="20,14" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,3 L22,20 H2 Z M12,9 V13 M12,17 H12.01" Stroke="#5D9BE6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,1,12,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="Software adicional de fabricante detectado" FontSize="14.5" FontWeight="SemiBold" Foreground="#5D9BE6" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtDetectedBloatList" Text="" FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- OPCIÓN 1: WINDOWS RECIÉN INSTALADO -->
                        <Button x:Name="BtnFreshInstall" Style="{StaticResource PrepOptionButtonStyle}" Margin="0,0,0,0" Click="BtnFreshInstall_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                    <TextBlock Text="Windows recién instalado" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock Text="Crea el punto de restauración preventivo e instala únicamente los controladores esenciales sin telemetría ni paneles extra."
                                               FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Instalar" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,8,0"/>
                                    <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#3474C6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- BARRA DESPLEGABLE DE OPCIÓN 1 -->
                        <Border x:Name="ProgressPanelFresh" Visibility="Collapsed" Background="#07080C" BorderBrush="#1C1E28" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="28,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TxtStatusFresh" Text="Completado" FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtPercentFresh" Text="100%" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Grid>
                                <ProgressBar x:Name="ProgressFresh" Minimum="0" Maximum="100" Value="0"/>
                            </StackPanel>
                        </Border>

                        <Border Height="14"/>

                        <!-- OPCIÓN 2: YA INSTALÉ DRIVERS O UTILIDADES -->
                        <Button x:Name="BtnCleanAndInstall" Style="{StaticResource PrepOptionButtonStyle}" Margin="0,0,0,0" Click="BtnCleanAndInstall_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                    <TextBlock Text="Ya instalé drivers o utilidades de fabricante" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock Text="Limpia controladores previos y programas como Armoury Crate o GeForce Experience, reinicia el equipo y deja la base limpia."
                                               FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Limpiar" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,8,0"/>
                                    <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#3474C6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- BARRA DESPLEGABLE DE OPCIÓN 2 -->
                        <Border x:Name="ProgressPanelClean" Visibility="Collapsed" Background="#07080C" BorderBrush="#1C1E28" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="28,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TxtStatusClean" Text="Completado" FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtPercentClean" Text="100%" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Grid>
                                <ProgressBar x:Name="ProgressClean" Minimum="0" Maximum="100" Value="0"/>
                            </StackPanel>
                        </Border>

                        <!-- BLOQUE SEPARADO: CONTINUACIÓN DIRECTA (SIN BARRA AZUL DEBAJO) -->
                        <Separator Background="#1C1E28" Margin="0,28,0,22"/>

                        <TextBlock Text="¿Ya contás con tus controladores limpios y configurados?"
                                   FontSize="15.5" FontWeight="Medium" Foreground="#E4E4EC" Margin="2,0,0,12"/>

                        <Button x:Name="BtnSkipDrivers" Style="{StaticResource PrepOptionButtonStyle}" Click="BtnSkipDrivers_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                    <TextBlock Text="Ya tengo mis controladores listos" FontSize="17.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,5"/>
                                    <TextBlock Text="Genera el respaldo preventivo obligatorio y pasa directamente al panel de ajustes del sistema."
                                               FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Continuar" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,8,0"/>
                                    <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#3474C6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- SECCIÓN INFERIOR: ¿POR QUÉ HACEMOS ESTE PASO? -->
                        <Separator Background="#1C1E28" Margin="0,32,0,26"/>

                        <TextBlock Text="¿Por qué hacemos este paso?" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="M12,2 L20,6 V12 C20,17.5 16.5,21.5 12,23 C7.5,21.5 4,17.5 4,12 V6 L12,2 Z"
                                          Stroke="#3474C6" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Respaldo preventivo" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <TextBlock Text="Guarda una copia exacta del estado actual de Windows antes de tocar cualquier clave. No consume rendimiento y usa como máximo el 5% del disco."
                                           FontSize="14.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="M4,6 H20 V18 H4 Z M8,2 V6 M16,2 V6"
                                          Stroke="#3474C6" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Drivers sin basura" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <TextBlock Text="Evita que Windows Update instale paquetes genéricos y prepara Chipset y GPU sin servicios corriendo en segundo plano."
                                           FontSize="14.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z"
                                          Stroke="#3474C6" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Cambios reversibles" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <TextBlock Text="Cada ajuste permite revisar qué modifica en el Registro y volver al estado original de Windows en un clic."
                                           FontSize="14.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- HUD FLOTANTE MINIMALISTA CON ANILLO DOBLE DE TELEMETRÍA CENTRADO -->
                <Grid x:Name="PrepModalOverlay" Visibility="Collapsed" Background="#C8050609">
                    <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Grid Width="104" Height="104" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Ellipse Width="104" Height="104" Stroke="#182236" StrokeThickness="2.2"/>
                            <Path Data="M52,2 A50,50 0 0,1 102,52" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="LoadingRingRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>

                            <Ellipse Width="74" Height="74" Stroke="#121A29" StrokeThickness="1.6"/>
                            <Path Data="M52,89 A37,37 0 0,1 15,52" Stroke="#255EA8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="LoadingInnerRingRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>

                            <Ellipse Width="8" Height="8" Fill="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="TxtModalStepTag" Text="ETAPA 1 DE 3 · RESPALDO DEL SISTEMA"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#5D9BE6"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtModalTitle" Text="Preparando sistema"
                                   FontSize="25" FontWeight="SemiBold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock x:Name="TxtModalMessage" Text="Creando punto de restauración preventivo en el sistema..."
                                   FontSize="15.5" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,28"/>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Procesando configuración" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtModalPercent" Text="0%" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </Grid>

                        <ProgressBar x:Name="ModalProgressBar" Height="9" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>
                </Grid>

                <!-- VISTA 3: PANEL DE AJUSTES -->
                <Grid x:Name="MainOptimizerView" Visibility="Collapsed" Margin="26,18,22,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- MENÚ LATERAL -->
                    <StackPanel x:Name="SidebarMenu" Grid.Column="0" Margin="0,0,24,0">
                        <Button x:Name="BtnBackToStepZero" Style="{StaticResource GhostButtonStyle}"
                                HorizontalContentAlignment="Left" Margin="0,0,0,16" Click="BtnBackToStepZero_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,10.5 L12,3 L21,10.5 V20 H15 V14 H9 V20 H3 Z" Stroke="#D0D0DA" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0"/>
                                <TextBlock Text="Preparación" FontWeight="SemiBold" Foreground="#E4E4EC"/>
                            </StackPanel>
                        </Button>

                        <Button Content="Apps" Tag="Apps" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                        <Button Content="Gaming y Energía" Tag="Gaming y Energía" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                        <Button Content="Red y DNS" Tag="Red y DNS" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                        <Button Content="Debloat" Tag="Debloat" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                        <Button Content="Servicios" Tag="Servicios" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                        <Button Content="Limpieza" Tag="Limpieza" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                    </StackPanel>

                    <!-- CONTENIDO CENTRAL -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- BUSCADOR -->
                        <Border Grid.Row="0" Background="#CC090A0F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Margin="0,0,22,16">
                            <Grid>
                                <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="#FFFFFF"
                                         CaretBrush="#FFFFFF" BorderThickness="0"
                                         Padding="16,13" FontSize="15" TextChanged="TxtSearch_TextChanged"/>
                                <TextBlock Text="Buscar ajuste o aplicación..." Foreground="{StaticResource TextMuted}" FontSize="15"
                                           Margin="17,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- LISTA AGRUPADA CON ACORDEÓN DE INFORMACIÓN DEBAJO DE CADA TARJETA -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                            <ItemsControl x:Name="TweaksItemsControl">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,8,0,10">
                                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="#98A9C7"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Margin" Value="0,0,0,12"/>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#D9090A0F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,9">
                                            <StackPanel>
                                                <!-- FILA PRINCIPAL -->
                                                <Grid Margin="20,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"
                                                            Width="36" Height="36" CornerRadius="6" Background="#10131C" BorderBrush="#1F2433" BorderThickness="1"
                                                            Margin="0,0,15,0" VerticalAlignment="Center">
                                                        <Path Data="{Binding IconGeometry}" Fill="{Binding IconColor}"
                                                              Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15.5" FontWeight="Medium" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                    <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Padding="10,6" Margin="10,0" Tag="{Binding}" Click="BtnInfo_Click">
                                                        <TextBlock Text="ⓘ" FontSize="16" Foreground="#A6ACBE"/>
                                                    </Button>

                                                    <CheckBox Grid.Column="3" Style="{StaticResource ModernSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- PANEL DESPLEGABLE INLINE DEBAJO DE ESTE ÍTEM -->
                                                <Border Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVis}}"
                                                        Background="#0D1019" BorderBrush="#1C2334" BorderThickness="0,1,0,0"
                                                        CornerRadius="0,0,6,6" Padding="20,14">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="14.5" Foreground="#E4E8F2" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,7"/>
                                                        <TextBlock FontSize="13.5" Foreground="#A6B0C6" TextWrapping="Wrap">
                                                            <Run Text="Detalle técnico: " FontWeight="SemiBold" Foreground="#5D9BE6"/>
                                                            <Run Text="{Binding TechnicalDetail}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- BARRA INFERIOR -->
                        <Grid Grid.Row="2" Margin="0,16,22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Restaurar original" Style="{StaticResource SoftCardButtonStyle}" Padding="20,12" Click="BtnRestoreAll_Click"/>
                            <TextBlock x:Name="TxtActionFeedback" Grid.Column="1" Text="" FontSize="14.5" FontWeight="SemiBold" Foreground="#4CC38A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0"/>
                            <Button Grid.Column="2" Content="Aplicar cambios" Style="{StaticResource PrimaryButtonStyle}" Padding="26,12" Click="BtnApplyChanges_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
