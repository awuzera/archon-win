<Window x:Class="Archon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCHON v1.0"
        Height="660" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0E"
        Foreground="#F3F3F6"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgSurface" Color="#B315151C"/>
        <SolidColorBrush x:Key="BgSurfaceHover" Color="#CC1E1E27"/>
        <SolidColorBrush x:Key="BorderGlass" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="LineSubtle" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#C93B44"/>
        <SolidColorBrush x:Key="AccentPrimaryHover" Color="#DC4851"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A6A6B2"/>
        <SolidColorBrush x:Key="TextMuted" Color="#727280"/>

        <!-- SCROLLBAR MODERNO OSCURO -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#33FFFFFF" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTONES DE BARRA DE TÍTULO -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6A6B2"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B82D35"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="#33FFFFFF" BorderThickness="1"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TARJETA / BOTÓN TRASLÚCIDO -->
        <Style x:Key="SoftCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground" Value="#F3F3F6"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderGlass}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgSurfaceHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN DISCRETO -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#16FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SWITCH MODERNO -->
        <Style x:Key="ModernSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="46" Height="24" CornerRadius="12" Background="#262630">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="3,0" HorizontalAlignment="Left" Fill="#9A9AA6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentPrimary}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#22222B" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0A0E" Offset="0"/>
                <GradientStop Color="#0F0F15" Offset="0.55"/>
                <GradientStop Color="#0B0B10" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CAPA DE FONDO DIFUMINADO (GLOW AMBIENTAL) -->
            <Grid Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
                <!-- Resplandor superior central cálido -->
                <Ellipse Width="640" Height="380" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-110,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#36C93B44" Offset="0"/>
                            <GradientStop Color="#14C93B44" Offset="0.5"/>
                            <GradientStop Color="#00C93B44" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="85"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Resplandor secundario frío abajo a la derecha -->
                <Ellipse Width="560" Height="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-100">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#244B5596" Offset="0"/>
                            <GradientStop Color="#0C4B5596" Offset="0.55"/>
                            <GradientStop Color="#004B5596" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="95"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Sutil luz de profundidad abajo a la izquierda -->
                <Ellipse Width="420" Height="280" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-90,0,0,-80">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1AC93B44" Offset="0"/>
                            <GradientStop Color="#00C93B44" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="80"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <!-- BARRA SUPERIOR CON LOGO VECTORIAL -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Viewbox Width="22" Height="22" Margin="0,0,10,0">
                        <Canvas Width="64" Height="64">
                            <Path Data="M32,4 L58,18 L58,46 L32,60 L6,46 L6,18 Z" Fill="#241518" Stroke="#C93B44" StrokeThickness="3"/>
                            <Path Data="M32,14 L48,48 L40,48 L32,30 L24,48 L16,48 Z" Fill="#FFFFFF"/>
                            <Polygon Points="32,37 37,46 27,46" Fill="#C93B44"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Archon" FontWeight="SemiBold" FontSize="14.5" Foreground="#F3F3F6" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Style="{StaticResource WindowControlButtonStyle}" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- VISTA 1: PRESENTACIÓN CON LOGO CENTRAL E INTERACCIÓN DE HARDWARE -->
            <ScrollViewer x:Name="WelcomeView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,20,32,36">

                    <!-- EMBLEMA PRINCIPAL CON HALO DIFUMINADO -->
                    <Grid Width="92" Height="92" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Ellipse Width="84" Height="84" Fill="#45C93B44">
                            <Ellipse.Effect>
                                <BlurEffect Radius="26"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Viewbox Width="74" Height="74">
                            <Canvas Width="64" Height="64">
                                <Path Data="M32,3 L59,18 L59,46 L32,61 L5,46 L5,18 Z" Stroke="#33FFFFFF" StrokeThickness="2">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#26161A" Offset="0"/>
                                            <GradientStop Color="#14141B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Path Data="M32,12 L50,49 L41.5,49 L32,28.5 L22.5,49 L14,49 Z" Fill="#FFFFFF"/>
                                <Polygon Points="32,36 38,48 26,48" Fill="#D9414B"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <TextBlock Text="Archon" FontSize="38" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Preparación limpia de controladores, respaldo preventivo y ajuste fino para Windows sin procesos innecesarios."
                               FontSize="15.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                               TextAlignment="Center" LineHeight="24" Margin="0,0,0,28"/>

                    <!-- ACCIONES PRINCIPALES DE INICIO -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                        <Button x:Name="BtnStartStepZero" Style="{StaticResource PrimaryButtonStyle}" Padding="32,13" Margin="0,0,12,0" Click="BtnStartStepZero_Click">
                            <TextBlock Text="Comenzar" FontSize="15" FontWeight="SemiBold"/>
                        </Button>

                        <Button x:Name="BtnScanHardware" Style="{StaticResource SoftCardButtonStyle}" Padding="24,13" Click="BtnScanHardware_Click">
                            <TextBlock x:Name="TxtScanButtonLabel" Text="Ver mis componentes" FontSize="14.5" FontWeight="Medium"/>
                        </Button>
                    </StackPanel>

                    <!-- PANEL DESPLEGABLE INTERACTIVO DE HARDWARE -->
                    <Border x:Name="HardwareListPanel" Visibility="Collapsed" Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" CornerRadius="12" Padding="24,20" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Componentes detectados en tu equipo" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Procesador" FontSize="13.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtCpuValue" Text="Detectando..." FontSize="13.5" Foreground="#F3F3F6" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="{StaticResource LineSubtle}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Placa madre" FontSize="13.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtMotherValue" Text="Detectando..." FontSize="13.5" Foreground="#F3F3F6" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="{StaticResource LineSubtle}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Tarjeta gráfica" FontSize="13.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtGpuValue" Text="Detectando..." FontSize="13.5" Foreground="#F3F3F6" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="{StaticResource LineSubtle}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Memoria RAM" FontSize="13.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtRamValue" Text="Detectando..." FontSize="13.5" Foreground="#F3F3F6" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="{StaticResource LineSubtle}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Almacenamiento principal" FontSize="13.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtStorageValue" Text="Detectando..." FontSize="13.5" Foreground="#F3F3F6" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Background="{StaticResource LineSubtle}" Margin="0,0,0,10"/>

                            <Grid>
                                <TextBlock Text="Sistema operativo" FontSize="13.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtOsValue" Text="Detectando..." FontSize="13.5" Foreground="#F3F3F6" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- VISTA 2: PASO 0 -->
            <ScrollViewer x:Name="StepZeroView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="32,12,32,40">

                    <Button x:Name="BtnBackToWelcome" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="-12,0,0,12" Click="BtnBackToWelcome_Click">
                        <TextBlock Text="← Volver al inicio" FontSize="13.5"/>
                    </Button>

                    <TextBlock Text="Paso 0" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock Text="Elegí el estado actual de tu instalación para crear un respaldo automático y preparar tus controladores."
                               FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                               TextAlignment="Center" LineHeight="23" Margin="0,0,0,24"/>

                    <!-- AVISO SUTIL DE SOFTWARE DE FABRICANTE -->
                    <Border x:Name="BloatAlertBox" Visibility="Collapsed" Background="#B3221519" BorderBrush="#33C93B44" BorderThickness="1" CornerRadius="10" Padding="18,13" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Software adicional de fabricante detectado" FontSize="13.5" FontWeight="SemiBold" Foreground="#E5737B" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtDetectedBloatList" Text="" FontSize="13.5" Foreground="#D4D4DC" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- OPCIÓN A -->
                    <Button x:Name="BtnFreshInstall" Style="{StaticResource SoftCardButtonStyle}"
                            HorizontalContentAlignment="Stretch" Padding="24,20" Margin="0,0,0,14" Click="BtnFreshInstall_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Windows recién instalado" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                <TextBlock Text="No instalé controladores todavía. Crear un punto de seguridad e instalar únicamente los drivers esenciales sin telemetría."
                                           FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#29181D" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="Opción A" FontSize="12" FontWeight="SemiBold" Foreground="#E5737B"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- OPCIÓN B -->
                    <Button x:Name="BtnCleanAndInstall" Style="{StaticResource SoftCardButtonStyle}"
                            HorizontalContentAlignment="Stretch" Padding="24,20" Margin="0,0,0,24" Click="BtnCleanAndInstall_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Ya instalé drivers o programas de fabricante" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                <TextBlock Text="Limpiar controladores anteriores y utilidades como Armoury Crate o GeForce Experience, reiniciar y dejar la base limpia."
                                           FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1E1E28" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="Opción B" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- BARRA DE PROGRESO Y ESTADO -->
                    <StackPanel Margin="4,0,4,22">
                        <TextBlock x:Name="TxtStepZeroStatus" Text="Listo para comenzar"
                                   FontSize="13.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ProgressBar x:Name="StepZeroProgress" Height="6" Minimum="0" Maximum="100" Value="0"
                                     Background="#1E1E28" Foreground="{StaticResource AccentPrimary}" BorderThickness="0"/>
                    </StackPanel>

                    <!-- ACCESO DIRECTO AL PANEL DE AJUSTES -->
                    <Button x:Name="BtnSkipDrivers" Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Center" Padding="18,10" Click="BtnSkipDrivers_Click">
                        <TextBlock Text="Continuar al panel de ajustes →" FontSize="14.5" FontWeight="SemiBold" Foreground="#E2E2EA"/>
                    </Button>

                    <!-- EXPLICACIÓN INFERIOR -->
                    <Separator Background="{StaticResource LineSubtle}" Margin="0,34,0,28"/>

                    <StackPanel Margin="4,0">
                        <TextBlock Text="¿Por qué hacemos este paso?" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,18"/>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Punto de restauración automático" FontSize="15" FontWeight="SemiBold" Foreground="#EAEAEF" Margin="0,0,0,4"/>
                            <TextBlock Text="Antes de aplicar cambios, Archon guarda una copia exacta del estado actual de Windows. No consume rendimiento ni deja procesos activos, y utiliza como máximo el 5% del disco para que puedas volver atrás en cualquier momento."
                                       FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Controladores sin software adicional" FontSize="15" FontWeight="SemiBold" Foreground="#EAEAEF" Margin="0,0,0,4"/>
                            <TextBlock Text="Evita que Windows Update descargue versiones genéricas y prepara los paquetes de Chipset y GPU sin servicios en segundo plano."
                                       FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Transparencia total en cada ajuste" FontSize="15" FontWeight="SemiBold" Foreground="#EAEAEF" Margin="0,0,0,4"/>
                            <TextBlock Text="Cada opción del panel permite revisar qué clave del Registro modifica antes de aplicarla y revertir todos los cambios con un solo clic."
                                       FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- VISTA 3: PANEL DE OPTIMIZACIÓN -->
            <Grid x:Name="MainOptimizerView" Grid.Row="1" Visibility="Collapsed" Margin="20,10,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MENÚ LATERAL -->
                <StackPanel x:Name="SidebarMenu" Grid.Column="0" Margin="0,0,18,0">
                    <Button x:Name="BtnBackToStepZero" Style="{StaticResource GhostButtonStyle}"
                            HorizontalContentAlignment="Left" Margin="0,0,0,14" Click="BtnBackToStepZero_Click">
                        <TextBlock Text="← Paso 0" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    </Button>

                    <Button Content="Instalador Día 0" Tag="Instalador Día 0" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Content="Gaming y Energía" Tag="Gaming y Energía" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Content="Red y DNS" Tag="Red y DNS" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Content="Debloat" Tag="Debloat" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Content="Servicios" Tag="Servicios" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Content="Limpieza" Tag="Limpieza" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                </StackPanel>

                <!-- CONTENIDO CENTRAL -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BUSCADOR LIMPIO -->
                    <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                        <Grid>
                            <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="#FFFFFF"
                                     CaretBrush="#FFFFFF" BorderThickness="0"
                                     Padding="14,11" FontSize="14" TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock Text="Buscar ajuste..." Foreground="{StaticResource TextMuted}" FontSize="14"
                                       Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- LISTA DE AJUSTES -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TweaksItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" CornerRadius="9" Padding="18,14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="14.5" FontWeight="Medium" Foreground="#F3F3F6" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                            <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Padding="10,6" Margin="10,0" Tag="{Binding}" Click="BtnInfo_Click">
                                                <TextBlock Text="ⓘ" FontSize="15" Foreground="{StaticResource TextMuted}"/>
                                            </Button>

                                            <CheckBox Grid.Column="2" Style="{StaticResource ModernSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- INSPECTOR DE DETALLE -->
                    <Border x:Name="InspectorPanel" Grid.Row="2" Visibility="Collapsed" Background="#CC16161F" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,10,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtInspectorTitle" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtInspectorDesc" FontSize="13.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtInspectorTech" FontSize="12.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Cerrar" Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Top" Margin="12,0,0,0" Click="BtnCloseInspector_Click"/>
                        </Grid>
                    </Border>

                    <!-- BARRA INFERIOR -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Restaurar original" Style="{StaticResource SoftCardButtonStyle}" Padding="18,11" Click="BtnRestoreAll_Click"/>
                        <TextBlock x:Name="TxtActionFeedback" Grid.Column="1" Text="" FontSize="13.5" FontWeight="SemiBold" Foreground="#4CC38A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0"/>
                        <Button Grid.Column="2" Content="Aplicar cambios" Style="{StaticResource PrimaryButtonStyle}" Padding="24,11" Click="BtnApplyChanges_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
