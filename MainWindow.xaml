                                        <Path Data="M3,13 H7 L10,5 L14,19 L17,11 H21"
                                              Stroke="#5D9BE6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtPerformanceButtonLabel" Text="Performance" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- INDICADOR DE CARGA ANTES DE MOSTRAR COMPONENTES -->
                            <Border x:Name="HardwareLoadingPanel" Visibility="Collapsed" MinWidth="660" Background="#CC090A0F"
                                    BorderBrush="#22304A" BorderThickness="1" CornerRadius="7" Padding="26,22" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Grid Width="34" Height="34" Margin="0,0,16,0">
                                        <Ellipse Width="34" Height="34" Stroke="#1B263B" StrokeThickness="2.5"/>
                                        <Path Data="M17,2 A15,15 0 0,1 32,17" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="HardwareSpinnerRotate" Angle="0"/>
