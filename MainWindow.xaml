<Window x:Class="Archon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCHON v1.0"
        Height="740" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="#07070A"
        Foreground="#F5F5F8"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" CornerRadius="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="BgCardBlack" Color="#09090D"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#11131C"/>
        <SolidColorBrush x:Key="BorderDark" Color="#1C1E28"/>
        <SolidColorBrush x:Key="BorderHover" Color="#2C3C59"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#1B4985"/>
        <SolidColorBrush x:Key="AccentPrimaryHover" Color="#2359A1"/>
        <SolidColorBrush x:Key="AccentLine" Color="#3474C6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#D0D0DA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9696A4"/>

        <!-- ILUMINACIÓN DE FONDO FLUIDA (60 FPS SIN LAG) -->
        <Storyboard x:Key="AmbientGlowStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="AuroraTopTransform"
                             Storyboard.TargetProperty="X"
                             From="-110" To="110" Duration="0:0:12" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuroraTop"
                             Storyboard.TargetProperty="Opacity"
                             From="0.65" To="1.0" Duration="0:0:7" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="AuroraBottomTransform"
                             Storyboard.TargetProperty="X"
                             From="100" To="-100" Duration="0:0:14" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuroraBottom"
                             Storyboard.TargetProperty="Opacity"
                             From="0.90" To="0.50" Duration="0:0:8.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ROTACIÓN SUAVE PARA EL INDICADOR DE CARGA -->
        <Storyboard x:Key="LoadingRingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoadingRingRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:2.4"/>
        </Storyboard>

        <!-- SCROLLBAR MÁS ANCHO Y SEPARADO -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,2,0,2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#282B38" CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#3D4357"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BARRA DE PROGRESO REDONDEADA -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="#151822"/>
            <Setter Property="Foreground" Value="#2D6EC2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3.5"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3.5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTONES DE VENTANA -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A8A8B6"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14161F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B82D35"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN PRINCIPAL (AZUL MÁS OSCURO) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="#2863B0" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PANEL / BOTÓN OSCURO DE SUPERFICIE -->
        <Style x:Key="SoftCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCardBlack}"/>
            <Setter Property="Foreground" Value="#F5F5F8"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderDark}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgCardHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BLOQUE DE OPCIÓN UNIFORME PARA PREPARACIÓN -->
        <Style x:Key="PrepOptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCardBlack}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="Foreground" Value="#F5F5F8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Border x:Name="LeftAccent" Width="3" HorizontalAlignment="Left" CornerRadius="6,0,0,6" Background="Transparent"/>
                                <Border Padding="26,20">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource BgCardHover}"/>
                                <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                                <Setter TargetName="LeftAccent" Property="Background" Value="#2D6EC2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RowBg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN DE NAVEGACIÓN DISCRETO -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#141620"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SWITCH LIMPIO -->
        <Style x:Key="ModernSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="44" Height="22" CornerRadius="5" Background="#1D1F2A">
                            <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="3" Margin="3,0" HorizontalAlignment="Left" Background="#9A9AA8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentPrimary}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1A1C26" BorderThickness="1" CornerRadius="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#06070A" Offset="0"/>
                <GradientStop Color="#080B12" Offset="0.5"/>
                <GradientStop Color="#06070A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR NEGRA CON LÍNEA SUTIL E ÍCONO DE OJO GEOMÉTRICO -->
            <Border Grid.Row="0" Background="#050507" BorderBrush="#12141C" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Viewbox Width="24" Height="16" Margin="0,0,10,0">
                            <Canvas Width="72" Height="44">
                                <Path Data="M3,22 C18,6 54,6 69,22 C54,38 18,38 3,22 Z" Fill="#0A0E17" Stroke="#3474C6" StrokeThickness="3.2" StrokeLineJoin="Round"/>
                                <Ellipse Canvas.Left="25" Canvas.Top="11" Width="22" Height="22" Stroke="#FFFFFF" StrokeThickness="2.4" Fill="#070A12"/>
                                <Polygon Points="36,16 42,22 36,28 30,22" Fill="#3474C6"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Archon" FontWeight="SemiBold" FontSize="14.5" Foreground="#F5F5F8" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.0" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Style="{StaticResource WindowControlButtonStyle}" Click="Minimize_Click"/>
                        <Button Content="✕" Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENEDOR PRINCIPAL -->
            <Grid Grid.Row="1">

                <!-- ILUMINACIÓN DE FONDO FLUIDA SIN BLUR PESADO -->
                <Grid x:Name="AmbientGlowLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="AuroraTop" Width="1360" Height="640" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-100,-180,-100,0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AuroraTopTransform" X="0" Y="0"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.55" RadiusY="0.65">
                                <GradientStop Color="#361B4985" Offset="0.0"/>
                                <GradientStop Color="#201B4985" Offset="0.35"/>
                                <GradientStop Color="#0D1B4985" Offset="0.68"/>
                                <GradientStop Color="#001B4985" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle x:Name="AuroraBottom" Width="1360" Height="620" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-100,0,-100,-220">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AuroraBottomTransform" X="0" Y="0"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.65" GradientOrigin="0.5,0.65" RadiusX="0.58" RadiusY="0.65">
                                <GradientStop Color="#2B163C6E" Offset="0.0"/>
                                <GradientStop Color="#16163C6E" Offset="0.42"/>
                                <GradientStop Color="#07163C6E" Offset="0.72"/>
                                <GradientStop Color="#00163C6E" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- VISTA 1: PRESENTACIÓN -->
                <ScrollViewer x:Name="WelcomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="WelcomeContentPanel" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,12,32,32">
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>

                        <!-- EMBLEMA DE OJO DISTINTIVO -->
                        <Border x:Name="WelcomeLogoContainer" Width="106" Height="56" HorizontalAlignment="Center" Margin="0,0,0,2" Background="Transparent" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Viewbox Width="102" Height="54">
                                <Canvas Width="102" Height="54">
                                    <!-- Trazo exterior afilado -->
                                    <Path Data="M4,27 C24,5 78,5 98,27 C78,49 24,49 4,27 Z" Fill="#080B13" Stroke="#3474C6" StrokeThickness="2.6" StrokeLineJoin="Round"/>
                                    <!-- Contorno interior técnico -->
                                    <Path Data="M16,27 C31,12 71,12 86,27" Stroke="#5894E2" StrokeThickness="1.1" Opacity="0.65"/>
                                    <!-- Anillo de iris -->
                                    <Ellipse Canvas.Left="37" Canvas.Top="13" Width="28" Height="28" Fill="#060910" Stroke="#FFFFFF" StrokeThickness="2.1"/>
                                    <!-- Segmento interno de iris -->
                                    <Path Data="M51,16 A11,11 0 0,1 62,27" Stroke="#4B8CE0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M51,38 A11,11 0 0,1 40,27" Stroke="#4B8CE0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <!-- Pupila geométrica -->
                                    <Polygon Points="51,20 58,27 51,34 44,27" Fill="#1B4985" Stroke="#5D9BE6" StrokeThickness="1.2"/>
                                    <!-- Destello óptico -->
                                    <Ellipse Canvas.Left="54.5" Canvas.Top="19.5" Width="3" Height="3" Fill="#FFFFFF"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="Archon" FontSize="40" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                        <TextBlock Text="Bienvenido" FontSize="17.5" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,0,0,28"/>

                        <!-- BOTONES PRINCIPALES -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                            <Button x:Name="BtnStartStepZero" Style="{StaticResource PrimaryButtonStyle}" Padding="34,13" Margin="0,0,12,0" Click="BtnStartStepZero_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Comenzar" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="10,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnScanHardware" Style="{StaticResource SoftCardButtonStyle}" Padding="22,13" Click="BtnScanHardware_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M9,2 V5 M15,2 V5 M9,19 V22 M15,19 V22 M2,9 H5 M2,15 H5 M19,9 H22 M19,15 H22 M6,5 H18 A1,1 0 0 1 19,6 V18 A1,1 0 0 1 18,19 H6 A1,1 0 0 1 5,18 V6 A1,1 0 0 1 6,5 Z M9,9 H15 V15 H9 Z"
                                          Stroke="#D0D0DA" StrokeThickness="1.7" Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtScanButtonLabel" Text="Ver mis componentes" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- PANEL INTERACTIVO DE HARDWARE -->
                        <Border x:Name="HardwareListPanel" Visibility="Collapsed" MinWidth="600" Background="{StaticResource BgCardBlack}"
                                BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="Componentes detectados" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Procesador" FontSize="14.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtCpuValue" Text="Detectando..." FontSize="14.5" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                                <Separator Background="#1B1C26" Margin="0,0,0,11"/>

                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Placa madre" FontSize="14.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtMotherValue" Text="Detectando..." FontSize="14.5" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                                <Separator Background="#1B1C26" Margin="0,0,0,11"/>

                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tarjeta gráfica" FontSize="14.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtGpuValue" Text="Detectando..." FontSize="14.5" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                                <Separator Background="#1B1C26" Margin="0,0,0,11"/>

                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Memoria RAM" FontSize="14.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtRamValue" Text="Detectando..." FontSize="14.5" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                                <Separator Background="#1B1C26" Margin="0,0,0,11"/>

                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Almacenamiento" FontSize="14.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtStorageValue" Text="Detectando..." FontSize="14.5" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                                <Separator Background="#1B1C26" Margin="0,0,0,11"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sistema operativo" FontSize="14.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtOsValue" Text="Detectando..." FontSize="14.5" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VISTA 2: PREPARACIÓN DEL SISTEMA -->
                <ScrollViewer x:Name="StepZeroView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Effect>
                        <BlurEffect x:Name="StepZeroBlur" Radius="0"/>
                    </ScrollViewer.Effect>

                    <StackPanel Width="980" HorizontalAlignment="Center" Margin="28,16,28,44">

                        <!-- BOTÓN INICIO -->
                        <Button x:Name="BtnBackToWelcome" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="-10,0,0,14" Click="BtnBackToWelcome_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,10.5 L12,3 L21,10.5 V20 A1,1 0 0 1 20,21 H15 V14 H9 V21 H4 A1,1 0 0 1 3,20 Z"
                                      Stroke="#D0D0DA" StrokeThickness="1.7" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Inicio" FontSize="14.5" FontWeight="Medium" Foreground="#E4E4EC" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ENCABEZADO -->
                        <TextBlock Text="Preparación del sistema" FontSize="27" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>

                        <TextBlock Text="Elegí el estado actual de tu Windows para preparar los controladores antes de pasar al panel de ajustes."
                                   FontSize="15.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,22"/>

                        <!-- AVISO DE BLOATWARE DETECTADO -->
                        <Border x:Name="BloatAlertBox" Visibility="Collapsed" Background="#0C111C" BorderBrush="#23334F" BorderThickness="1" CornerRadius="6" Padding="18,13" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,3 L22,20 H2 Z M12,9 V13 M12,17 H12.01" Stroke="#5D9BE6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,1,12,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="Software adicional de fabricante detectado" FontSize="14.5" FontWeight="SemiBold" Foreground="#5D9BE6" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtDetectedBloatList" Text="" FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- OPCIÓN 1: WINDOWS RECIÉN INSTALADO -->
                        <Button x:Name="BtnFreshInstall" Style="{StaticResource PrepOptionButtonStyle}" Margin="0,0,0,0" Click="BtnFreshInstall_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="Windows recién instalado" FontSize="17.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,5"/>
                                    <TextBlock Text="Crea el punto de restauración preventivo e instala únicamente los controladores esenciales sin telemetría ni paneles extra."
                                               FontSize="14.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Instalar" FontSize="14.5" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,8,0"/>
                                    <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#3474C6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- BARRA DESPLEGABLE DE OPCIÓN 1 -->
                        <Border x:Name="ProgressPanelFresh" Visibility="Collapsed" Background="#07080C" BorderBrush="#1C1E28" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="26,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TxtStatusFresh" Text="Completado" FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtPercentFresh" Text="100%" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Grid>
                                <ProgressBar x:Name="ProgressFresh" Minimum="0" Maximum="100" Value="0"/>
                            </StackPanel>
                        </Border>

                        <Border Height="14"/>

                        <!-- OPCIÓN 2: YA INSTALÉ DRIVERS O UTILIDADES -->
                        <Button x:Name="BtnCleanAndInstall" Style="{StaticResource PrepOptionButtonStyle}" Margin="0,0,0,0" Click="BtnCleanAndInstall_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="Ya instalé drivers o utilidades de fabricante" FontSize="17.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,5"/>
                                    <TextBlock Text="Limpia controladores previos y programas como Armoury Crate o GeForce Experience, reinicia el equipo y deja la base limpia."
                                               FontSize="14.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Limpiar" FontSize="14.5" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,8,0"/>
                                    <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#3474C6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- BARRA DESPLEGABLE DE OPCIÓN 2 -->
                        <Border x:Name="ProgressPanelClean" Visibility="Collapsed" Background="#07080C" BorderBrush="#1C1E28" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="26,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TxtStatusClean" Text="Completado" FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtPercentClean" Text="100%" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Grid>
                                <ProgressBar x:Name="ProgressClean" Minimum="0" Maximum="100" Value="0"/>
                            </StackPanel>
                        </Border>

                        <!-- BLOQUE SEPARADO: CONTINUACIÓN DIRECTA -->
                        <Separator Background="#1C1E28" Margin="0,26,0,20"/>

                        <TextBlock Text="¿Ya contás con tus controladores limpios y configurados?"
                                   FontSize="15" FontWeight="Medium" Foreground="#E4E4EC" Margin="2,0,0,12"/>

                        <Button x:Name="BtnSkipDrivers" Style="{StaticResource PrepOptionButtonStyle}" Click="BtnSkipDrivers_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="Ya tengo mis controladores listos" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBlock Text="Genera el respaldo preventivo obligatorio y pasa directamente al panel de ajustes del sistema."
                                               FontSize="14.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Continuar" FontSize="14.5" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,8,0"/>
                                    <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#3474C6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- BARRA DESPLEGABLE DE OPCIÓN 3 -->
                        <Border x:Name="ProgressPanelSkip" Visibility="Collapsed" Background="#07080C" BorderBrush="#1C1E28" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="26,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TxtStatusSkip" Text="Creando punto de restauración preventivo..." FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtPercentSkip" Text="0%" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Grid>
                                <ProgressBar x:Name="ProgressSkip" Minimum="0" Maximum="100" Value="0"/>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN INFERIOR: ¿POR QUÉ HACEMOS ESTE PASO? -->
                        <Separator Background="#1C1E28" Margin="0,30,0,24"/>

                        <TextBlock Text="¿Por qué hacemos este paso?" FontSize="19" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="M12,2 L20,6 V12 C20,17.5 16.5,21.5 12,23 C7.5,21.5 4,17.5 4,12 V6 L12,2 Z"
                                          Stroke="#3474C6" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Respaldo preventivo" FontSize="15.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <TextBlock Text="Guarda una copia exacta del estado actual de Windows antes de tocar cualquier clave. No consume rendimiento y usa como máximo el 5% del disco."
                                           FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="M4,6 H20 V18 H4 Z M8,2 V6 M16,2 V6"
                                          Stroke="#3474C6" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Drivers sin basura" FontSize="15.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <TextBlock Text="Evita que Windows Update instale paquetes genéricos y prepara Chipset y GPU sin servicios corriendo en segundo plano."
                                           FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z"
                                          Stroke="#3474C6" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                    <TextBlock Text="Cambios reversibles" FontSize="15.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <TextBlock Text="Cada ajuste permite revisar qué modifica en el Registro y volver al estado original de Windows en un clic."
                                           FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- HUD FLOTANTE MINIMALISTA SOBRE FONDO DIFUMINADO (SIN CUADRO RECTANGULAR) -->
                <Grid x:Name="PrepModalOverlay" Visibility="Collapsed" Background="#C4050609">
                    <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- EMBLEMA CENTRAL CON ANILLO GIRATORIO -->
                        <Grid Width="92" Height="92" HorizontalAlignment="Center" Margin="0,0,0,22">
                            <Ellipse Width="92" Height="92" Stroke="#1B2840" StrokeThickness="2"/>
                            <Path Data="M46,2 A44,44 0 0,1 90,46" Stroke="#3B82F6" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="LoadingRingRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>

                            <Viewbox Width="54" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="72" Height="44">
                                    <Path Data="M3,22 C18,6 54,6 69,22 C54,38 18,38 3,22 Z" Fill="#0A0E17" Stroke="#3474C6" StrokeThickness="3.2" StrokeLineJoin="Round"/>
                                    <Ellipse Canvas.Left="25" Canvas.Top="11" Width="22" Height="22" Stroke="#FFFFFF" StrokeThickness="2.4" Fill="#070A12"/>
                                    <Polygon Points="36,16 42,22 36,28 30,22" Fill="#3474C6"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <!-- ETIQUETA DE ETAPA -->
                        <TextBlock x:Name="TxtModalStepTag" Text="ETAPA 1 DE 3 · RESPALDO DEL SISTEMA"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#5D9BE6"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <!-- TÍTULO DE ACCIÓN -->
                        <TextBlock x:Name="TxtModalTitle" Text="Preparando sistema"
                                   FontSize="23" FontWeight="SemiBold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- MENSAJE DE ESTADO ACTUAL -->
                        <TextBlock x:Name="TxtModalMessage" Text="Creando punto de restauración preventivo en el sistema..."
                                   FontSize="15" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"/>

                        <!-- BARRA DE PROGRESO + PORCENTAJE EN BLANCO -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Procesando configuración" FontSize="13.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtModalPercent" Text="0%" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </Grid>

                        <ProgressBar x:Name="ModalProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>
                </Grid>

                <!-- VISTA 3: PANEL DE AJUSTES -->
                <Grid x:Name="MainOptimizerView" Visibility="Collapsed" Margin="24,16,20,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="225"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- MENÚ LATERAL -->
                    <StackPanel x:Name="SidebarMenu" Grid.Column="0" Margin="0,0,22,0">
                        <Button x:Name="BtnBackToStepZero" Style="{StaticResource GhostButtonStyle}"
                                HorizontalContentAlignment="Left" Margin="0,0,0,14" Click="BtnBackToStepZero_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,10.5 L12,3 L21,10.5 V20 H15 V14 H9 V20 H3 Z" Stroke="#D0D0DA" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0"/>
                                <TextBlock Text="Preparación" FontWeight="SemiBold" Foreground="#E4E4EC"/>
                            </StackPanel>
                        </Button>

                        <Button Content="Apps" Tag="Apps" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Left" Padding="15,11" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                        <Button Content="Gaming y Energía" Tag="Gaming y Energía" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="15,11" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                        <Button Content="Red y DNS" Tag="Red y DNS" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="15,11" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                        <Button Content="Debloat" Tag="Debloat" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="15,11" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                        <Button Content="Servicios" Tag="Servicios" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="15,11" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                        <Button Content="Limpieza" Tag="Limpieza" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="15,11" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    </StackPanel>

                    <!-- CONTENIDO CENTRAL -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- BUSCADOR (ALINEADO CON LAS TARJETAS RESPETANDO EL ESPACIO DEL SCROLLBAR) -->
                        <Border Grid.Row="0" Background="{StaticResource BgCardBlack}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Margin="0,0,22,16">
                            <Grid>
                                <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="#FFFFFF"
                                         CaretBrush="#FFFFFF" BorderThickness="0"
                                         Padding="15,12" FontSize="14.5" TextChanged="TxtSearch_TextChanged"/>
                                <TextBlock Text="Buscar ajuste o aplicación..." Foreground="{StaticResource TextMuted}" FontSize="14.5"
                                           Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- LISTA AGRUPADA CON ÍCONOS Y PADDING SEPARADO DEL SCROLLBAR -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                            <ItemsControl x:Name="TweaksItemsControl">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,8,0,10">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#8898B5"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Margin" Value="0,0,0,10"/>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgCardBlack}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="18,14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- ÍCONO DE APLICACIÓN (SOLO VISIBLE CUANDO TIENE ICONO) -->
                                                <Border Grid.Column="0" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"
                                                        Width="34" Height="34" CornerRadius="6" Background="#10131C" BorderBrush="#1F2433" BorderThickness="1"
                                                        Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <Path Data="{Binding IconGeometry}" Fill="{Binding IconColor}"
                                                          Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" FontWeight="Medium" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Padding="10,6" Margin="10,0" Tag="{Binding}" Click="BtnInfo_Click">
                                                    <TextBlock Text="ⓘ" FontSize="15" Foreground="{StaticResource TextMuted}"/>
                                                </Button>

                                                <CheckBox Grid.Column="3" Style="{StaticResource ModernSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- INSPECTOR DE DETALLE -->
                        <Border x:Name="InspectorPanel" Grid.Row="2" Visibility="Collapsed" Background="#0A0B10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="18,14" Margin="0,10,22,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TxtInspectorTitle" FontSize="14.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtInspectorDesc" FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtInspectorTech" FontSize="13" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Cerrar" Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Top" Margin="12,0,0,0" Click="BtnCloseInspector_Click"/>
                            </Grid>
                        </Border>

                        <!-- BARRA INFERIOR -->
                        <Grid Grid.Row="3" Margin="0,14,22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Restaurar original" Style="{StaticResource SoftCardButtonStyle}" Padding="18,11" Click="BtnRestoreAll_Click"/>
                            <TextBlock x:Name="TxtActionFeedback" Grid.Column="1" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#4CC38A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0"/>
                            <Button Grid.Column="2" Content="Aplicar cambios" Style="{StaticResource PrimaryButtonStyle}" Padding="24,11" Click="BtnApplyChanges_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
