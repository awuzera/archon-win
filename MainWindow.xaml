                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtHardwareLoadingTitle" Text="Scanning system hardware..." FontSize="15.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtHardwareLoadingSub" Text="Reading CPU, GPU, RAM, storage and motherboard sensors..." FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- PANEL INTERACTIVO DE HARDWARE -->
                            <Border x:Name="HardwareListPanel" Visibility="Collapsed" MinWidth="680" Background="#CC090A0F"
                                    BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="7" Padding="26,22">
                                <StackPanel>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" x:Name="TxtDetectedComponentsTitle" Text="Detected components" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                        <Button Grid.Column="1" x:Name="BtnViewAllHardware" Style="{StaticResource GhostButtonStyle}" Padding="10,5" Click="BtnViewAllHardware_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtSeeMoreLabel" Text="See more" FontSize="14.5" FontWeight="SemiBold" Foreground="#5D9BE6" VerticalAlignment="Center"/>
                                                <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#5D9BE6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" Margin="6,1,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtLblCpu" Text="Processor" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtCpuValue" Text="Detecting..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtLblMother" Text="Motherboard" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtMotherValue" Text="Detecting..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtLblGpu" Text="Graphics card" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtGpuValue" Text="Detecting..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtLblRam" Text="Memory RAM" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtRamValue" Text="Detecting..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtLblStorage" Text="Storage" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtStorageValue" Text="Detecting..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtLblOs" Text="Operating system" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtOsValue" Text="Detecting..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- VISTA 1B: ESPECIFICACIONES COMPLETAS DEL EQUIPO -->
                <ScrollViewer x:Name="FullHardwareView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FullHardwareContainer" Width="1080" HorizontalAlignment="Center" Margin="28,18,28,48">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="FullHardwareSlideTransform" Y="0"/>
                        </StackPanel.RenderTransform>

                        <Button x:Name="BtnBackFromFullHardware" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="-10,0,0,14" Click="BtnBackFromFullHardware_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19,12 L5,12 M11,6 L5,12 L11,18"
                                      Stroke="#E4E7F2" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBackHomeLabel" Text="Back to home" FontSize="15" FontWeight="Medium" Foreground="#EEF1FA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="TxtFullSpecsTitle" Text="Full system specifications" FontSize="29" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,22"/>

                        <ItemsControl x:Name="FullHardwareSectionsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#D9090A0F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="7" Padding="26,20" Margin="0,0,0,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                <Border Width="4" Height="18" CornerRadius="2" Background="#3B82F6" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SectionTitle}" FontSize="18.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Specs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#161924" BorderThickness="0,0,0,1" Padding="0,12">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="310"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="16" FontWeight="Medium" Foreground="#CED5E6" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="16.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- VISTA 1C: RENDIMIENTO EN TIEMPO REAL (NUEVA PESTAÑA) -->
                <ScrollViewer x:Name="PerformanceView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Width="1120" HorizontalAlignment="Center" Margin="28,18,28,44">
                        <Grid Margin="0,0,0,14">
