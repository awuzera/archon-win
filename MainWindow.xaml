<Window x:Class="Archon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCHON v1.0"
        Height="700" Width="1120"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMainBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="None"
        BorderBrush="{StaticResource BorderGrayBrush}"
        BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- Barra de título custom -->
            <RowDefinition Height="44"/>   <!-- Telemetría de hardware -->
            <RowDefinition Height="*"/>    <!-- Contenido dinámico (Paso 0 o Dashboard) -->
        </Grid.RowDefinitions>

        <!-- FILA 0: BARRA DE TÍTULO -->
        <Border Grid.Row="0" Background="#080808" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="10" Height="10" Fill="{StaticResource AccentRedBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="ARCHON v1.0" FontFamily="Consolas" FontWeight="Bold" FontSize="13"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Width="38" Height="35" Background="Transparent" Foreground="White" BorderThickness="0" Click="Minimize_Click" FontFamily="Consolas"/>
                    <Button Content="□" Width="38" Height="35" Background="Transparent" Foreground="White" BorderThickness="0" Click="Maximize_Click" FontFamily="Consolas"/>
                    <Button Content="✕" Width="38" Height="35" Background="Transparent" Foreground="{StaticResource AccentRedBrush}" BorderThickness="0" Click="Close_Click" FontFamily="Consolas" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILA 1: BARRA SUPERIOR DE TELEMETRÍA -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="0,0,0,1" Padding="14,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,10,0">
                    <TextBlock x:Name="TxtCpuBadge" Text="[ CPU: ESCANEANDO... ]" FontFamily="Consolas" FontSize="12"/>
                </Border>
                <Border BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,10,0">
                    <TextBlock x:Name="TxtGpuBadge" Text="[ GPU: ESCANEANDO... ]" FontFamily="Consolas" FontSize="12"/>
                </Border>
                <Border BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,10,0">
                    <TextBlock x:Name="TxtRamBadge" Text="[ RAM: -- ]" FontFamily="Consolas" FontSize="12"/>
                </Border>
                <Border BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1" Padding="8,4">
                    <TextBlock x:Name="TxtOsBadge" Text="[ OS: -- ]" FontFamily="Consolas" FontSize="12"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- FILA 2A: VISTA OBLIGATORIA PASO 0 (DRIVERS + PUNTO DE RESTAURACIÓN) -->
        <Grid x:Name="StepZeroView" Grid.Row="2" Margin="28" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado Paso 0 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="[ PASO 0 // PREPARACIÓN DE BASE Y SEGURIDAD ]" Foreground="{StaticResource AccentRedBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Antes de aplicar cualquier optimización, aseguramos tu sistema y dejamos los drivers limpios." Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Alerta de Bloatware Detectado -->
            <Border x:Name="BloatAlertBox" Grid.Row="1" Background="#1C1010" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,18" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="[ ! ] SOFTWARE DE FABRICANTE / BLOAT DETECTADO EN ESTE EQUIPO:" Foreground="{StaticResource AccentRedBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="TxtDetectedBloatList" Text="" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Bloque Central: Opciones + Explicación del Punto de Restauración -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Elección de escenario -->
                <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1" Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SELECCIONÁ EL ESTADO ACTUAL DE TU PC:" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Margin="0,0,0,16"/>

                        <Button x:Name="BtnFreshInstall" Style="{StaticResource PrimaryRedButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,14" Click="BtnFreshInstall_Click">
                            <StackPanel>
                                <TextBlock Text="[ OPCIÓN A: WINDOWS RECIÉN INSTALADO ]" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="No instalé drivers todavía. Crear punto de seguridad e instalar solo controladores limpios." FontFamily="Segoe UI" FontSize="12" Foreground="#EAEAEA" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnCleanAndInstall" Style="{StaticResource RawButtonStyle}" HorizontalContentAlignment="Left" Click="BtnCleanAndInstall_Click">
                            <StackPanel>
                                <TextBlock Text="[ OPCIÓN B: YA INSTALÉ DRIVERS / BLOAT ]" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Borrar drivers viejos y basura (Armoury Crate / GeForce Exp), reiniciar y dejar todo limpio." FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Columna Derecha: Punto de Restauración Obligatorio y Log -->
                <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="[ SEGURIDAD OBLIGATORIA: PUNTO DE RESTAURACIÓN ]" Foreground="{StaticResource AccentRedBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        <TextBlock Text="Al iniciar cualquier opción, el programa guarda primero una copia exacta de tu Windows:" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="> ¿Baja los FPS? No. Cero procesos en segundo plano." FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="> ¿Llena el disco? No. Limitado automáticamente al 5%." FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="> ¿Para qué sirve? Volvés tu PC a este estado en 2 clics." FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,18"/>

                        <TextBlock x:Name="TxtStepZeroStatus" Text="ESTADO: Esperando selección..." FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="StepZeroProgress" Height="14" Minimum="0" Maximum="100" Value="0" Background="#0D0D0D" Foreground="{StaticResource AccentRedBrush}" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pie Paso 0: Salto para usuarios avanzados (igual crea punto de restauración) -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnSkipDrivers" Content="[ Ya tengo mis drivers limpios -> Ir al Optimizador ]" Style="{StaticResource RawButtonStyle}" FontSize="12" Click="BtnSkipDrivers_Click"/>
            </StackPanel>
        </Grid>

        <!-- FILA 2B: INTERFAZ PRINCIPAL DEL OPTIMIZADOR -->
        <Grid x:Name="MainOptimizerView" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Barra Lateral de Módulos -->
            <Border Grid.Column="0" Background="#111111" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="0,0,1,0" Padding="10,16">
                <StackPanel x:Name="SidebarMenu">
                    <Button Tag="Instalador Día 0" Content="> Instalador Día 0" Style="{StaticResource RawButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Tag="Gaming y Energía" Content="> Gaming y Energía" Style="{StaticResource PrimaryRedButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Tag="Red y DNS" Content="> Red y DNS" Style="{StaticResource RawButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Tag="Debloat" Content="> Debloat" Style="{StaticResource RawButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Tag="Servicios" Content="> Servicios" Style="{StaticResource RawButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Tag="Limpieza" Content="> Limpieza" Style="{StaticResource RawButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                </StackPanel>
            </Border>

            <!-- Panel Derecho: Buscador + Lista de Tarjetas + Barra de Acción -->
            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Buscador y Botones JSON -->
                    <RowDefinition Height="*"/>      <!-- Lista scrolleable de tarjetas -->
                    <RowDefinition Height="Auto"/>   <!-- Inspector [ i ] desplegable -->
                    <RowDefinition Height="Auto"/>   <!-- Barra inferior Restaurar / Aplicar -->
                </Grid.RowDefinitions>

                <!-- Barra Superior: Buscador e Importar/Exportar Perfil -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1" Margin="0,0,10,0">
                        <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="White" BorderThickness="0" Padding="10,8" FontFamily="Consolas" FontSize="13" TextChanged="TxtSearch_TextChanged"/>
                    </Border>

                    <Button Grid.Column="1" Content="[ Importar Perfil ]" Style="{StaticResource RawButtonStyle}" Margin="0,0,10,0" Click="BtnImportProfile_Click"/>
                    <Button Grid.Column="2" Content="[ Exportar JSON ]" Style="{StaticResource RawButtonStyle}" Click="BtnExportProfile_Click"/>
                </Grid>

                <!-- Lista de Tarjetas de Optimización -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TweaksItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                        <!-- Etiqueta [ SEGURO ] / [ RECOMENDADO ] -->
                                        <Border Grid.Column="1" BorderBrush="{Binding RiskColor}" BorderThickness="1" Padding="8,4" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RiskLabel}" Foreground="{Binding RiskColor}" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Botón de Transparencia [ i ] -->
                                        <Button Grid.Column="2" Content="[ i ]" Style="{StaticResource RawButtonStyle}" Padding="8,4" Margin="0,0,12,0" Tag="{Binding}" Click="BtnInfo_Click"/>

                                        <!-- Switch ON / OFF -->
                                        <CheckBox Grid.Column="3" Style="{StaticResource RawToggleSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Panel Inspector de Transparencia (se muestra al tocar [ i ]) -->
                <Border x:Name="InspectorPanel" Grid.Row="2" Background="#141010" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1" Padding="14" Margin="0,8,0,12" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock x:Name="TxtInspectorTitle" Text="" Foreground="{StaticResource AccentRedBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="TxtInspectorDesc" Text="" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,6"/>
                            <TextBlock x:Name="TxtInspectorTech" Text="" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Content="[ X ]" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource RawButtonStyle}" Padding="6,2" Click="BtnCloseInspector_Click"/>
                    </Grid>
                </Border>

                <!-- Barra Inferior de Acción -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Button Content="[ Restaurar original ]" HorizontalAlignment="Left" Style="{StaticResource RawButtonStyle}" Click="BtnRestoreAll_Click"/>
                    <TextBlock x:Name="TxtActionFeedback" Text="" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource AccentRedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="[ APLICAR CAMBIOS ]" HorizontalAlignment="Right" Style="{StaticResource PrimaryRedButtonStyle}" Padding="20,12" Click="BtnApplyChanges_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
