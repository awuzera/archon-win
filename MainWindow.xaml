                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19,12 L5,12 M11,6 L5,12 L11,18"
                                          Stroke="#E4E7F2" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPerfBackLabel" Text="Back to home" FontSize="15" FontWeight="Medium" Foreground="#EEF1FA" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border HorizontalAlignment="Right" Background="#0C1726" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPerfLiveBadge" Text="LIVE TELEMETRY · 1.0s" FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="TxtPerfTitle" Text="Real-time hardware performance" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtPerfSubtitle" Text="Live utilization, temperatures, clock speeds, memory and network throughput." FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,22"/>

                        <!-- FILA 1: CPU Y GPU -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- TARJETA CPU -->
                            <Border Grid.Column="0" Background="#D9090A0F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="22,18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtPerfCpuHeader" Text="PROCESSOR (CPU)" FontSize="12" FontWeight="Bold" Foreground="#5D9BE6"/>
                                            <TextBlock x:Name="TxtPerfCpuModel" Text="Detecting CPU..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtPerfCpuPct" Text="0%" FontSize="26" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="68" Background="#06080E" BorderBrush="#161C2B" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12" ClipToBounds="True">
                                        <Grid x:Name="PerfCpuGraphHost">
                                            <Polyline x:Name="PerfCpuSparkline" Stroke="#3B82F6" StrokeThickness="2.2" StrokeLineJoin="Round"/>
                                        </Grid>
                                    </Border>

                                    <ProgressBar x:Name="PerfCpuBar" Minimum="0" Maximum="100" Value="0" Height="6" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtPerfCpuTemp" Text="Temp: -- °C" FontSize="13" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtPerfCpuClock" Text="Clock: -- MHz" FontSize="13" Foreground="#D4D6E0" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtPerfCpuCores" Text="Cores: --" FontSize="13" Foreground="#A6ACBE" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- TARJETA GPU -->
                            <Border Grid.Column="2" Background="#D9090A0F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="22,18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtPerfGpuHeader" Text="GRAPHICS (GPU)" FontSize="12" FontWeight="Bold" Foreground="#34D399"/>
                                            <TextBlock x:Name="TxtPerfGpuModel" Text="Detecting GPU..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtPerfGpuPct" Text="0%" FontSize="26" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="68" Background="#06080E" BorderBrush="#161C2B" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12" ClipToBounds="True">
                                        <Grid x:Name="PerfGpuGraphHost">
                                            <Polyline x:Name="PerfGpuSparkline" Stroke="#10B981" StrokeThickness="2.2" StrokeLineJoin="Round"/>
                                        </Grid>
                                    </Border>

                                    <ProgressBar x:Name="PerfGpuBar" Foreground="#10B981" Minimum="0" Maximum="100" Value="0" Height="6" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtPerfGpuTemp" Text="Temp: -- °C" FontSize="13" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtPerfGpuVram" Text="VRAM: --" FontSize="13" Foreground="#D4D6E0" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtPerfGpuDriver" Text="Driver: --" FontSize="13" Foreground="#A6ACBE" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- FILA 2: RAM, DISCO Y RED -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- TARJETA RAM -->
                            <Border Grid.Column="0" Background="#D9090A0F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtPerfRamHeader" Text="MEMORY (RAM)" FontSize="12" FontWeight="Bold" Foreground="#A78BFA"/>
                                        <TextBlock x:Name="TxtPerfRamPct" Text="0%" FontSize="20" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="54" Background="#06080E" BorderBrush="#161C2B" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" ClipToBounds="True">
                                        <Grid x:Name="PerfRamGraphHost">
                                            <Polyline x:Name="PerfRamSparkline" Stroke="#8B5CF6" StrokeThickness="2" StrokeLineJoin="Round"/>
                                        </Grid>
                                    </Border>
                                    <ProgressBar x:Name="PerfRamBar" Foreground="#8B5CF6" Minimum="0" Maximum="100" Value="0" Height="5" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtPerfRamUsed" Text="0.0 / 0.0 GB" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtPerfRamSpeed" Text="Speed: --" FontSize="12" Foreground="#A6ACBE" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- TARJETA ALMACENAMIENTO -->
                            <Border Grid.Column="2" Background="#D9090A0F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtPerfDiskHeader" Text="STORAGE (SSD / NVMe)" FontSize="12" FontWeight="Bold" Foreground="#FBBF24"/>
                                        <TextBlock x:Name="TxtPerfDiskPct" Text="0%" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="54" Background="#06080E" BorderBrush="#161C2B" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" ClipToBounds="True">
                                        <Grid x:Name="PerfDiskGraphHost">
                                            <Polyline x:Name="PerfDiskSparkline" Stroke="#F59E0B" StrokeThickness="2" StrokeLineJoin="Round"/>
                                        </Grid>
                                    </Border>
                                    <ProgressBar x:Name="PerfDiskBar" Foreground="#F59E0B" Minimum="0" Maximum="100" Value="0" Height="5" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtPerfDiskRate" Text="R/W: 0.0 MB/s" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtPerfDiskModel" Text="Primary Disk" FontSize="12" Foreground="#A6ACBE" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- TARJETA RED -->
                            <Border Grid.Column="4" Background="#D9090A0F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtPerfNetHeader" Text="NETWORK" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock x:Name="TxtPerfNetSpeedTag" Text="0 KB/s" FontSize="17" FontWeight="Bold" Foreground="#0EA5E9" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="54" Background="#06080E" BorderBrush="#161C2B" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" ClipToBounds="True">
                                        <Grid x:Name="PerfNetGraphHost">
                                            <Polyline x:Name="PerfNetSparkline" Stroke="#0EA5E9" StrokeThickness="2" StrokeLineJoin="Round"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="TxtPerfNetDown" Text="↓ Download: 0 KB/s" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtPerfNetUp" Text="↑ Upload: 0 KB/s" FontSize="12.5" Foreground="#D4D6E0" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtPerfNetAdapter" Text="Adapter: --" FontSize="11.5" Foreground="#A6ACBE" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- VISTA 2: PREPARACIÓN DEL SISTEMA CON ANIMACIÓN ESCALONADA -->
                <ScrollViewer x:Name="StepZeroView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Effect>
                        <BlurEffect x:Name="StepZeroBlur" Radius="0"/>
                    </ScrollViewer.Effect>

                    <StackPanel Width="1080" HorizontalAlignment="Center" Margin="28,18,28,48">

                        <!-- BLOQUE 1: ENCABEZADO -->
                        <StackPanel x:Name="StepZeroHeaderBlock">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="StepZeroHeaderTransform" Y="0"/>
                            </StackPanel.RenderTransform>

                            <Button x:Name="BtnBackToWelcome" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="-10,0,0,14" Click="BtnBackToWelcome_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,10.5 L12,3 L21,10.5 V20 A1,1 0 0 1 20,21 H15 V14 H9 V21 H4 A1,1 0 0 1 3,20 Z"
                                          Stroke="#D0D0DA" StrokeThickness="1.7" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtHomeNavLabel" Text="Home" FontSize="14.5" FontWeight="Medium" Foreground="#E4E4EC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="TxtPrepTitle" Text="System preparation" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>

                            <TextBlock x:Name="TxtPrepSubtitle" Text="Choose your current Windows state to prepare drivers before entering the optimization panel."
                                       FontSize="16" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,24"/>
                        </StackPanel>

                        <!-- AVISO DE BLOATWARE DETECTADO -->
                        <Border x:Name="BloatAlertBox" Visibility="Collapsed" Background="#0C111C" BorderBrush="#23334F" BorderThickness="1" CornerRadius="6" Padding="20,14" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,3 L22,20 H2 Z M12,9 V13 M12,17 H12.01" Stroke="#5D9BE6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,1,12,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock x:Name="TxtBloatTitle" Text="OEM additional software detected" FontSize="14.5" FontWeight="SemiBold" Foreground="#5D9BE6" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtDetectedBloatList" Text="" FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- BLOQUE 2: OPCIÓN 1 -->
                        <Button x:Name="BtnFreshInstall" Style="{StaticResource PrepOptionButtonStyle}" Margin="0,0,0,0" Click="BtnFreshInstall_Click">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="FreshInstallTransform" Y="0"/>
                            </Button.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                    <TextBlock x:Name="TxtFreshTitle" Text="Fresh Windows installation" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtFreshDesc" Text="Creates a preventive restore point and installs only essential drivers without telemetry or extra panels."
                                               FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtFreshAction" Text="Install" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,8,0"/>
                                    <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#3474C6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Border x:Name="ProgressPanelFresh" Visibility="Collapsed" Background="#07080C" BorderBrush="#1C1E28" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="28,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TxtStatusFresh" Text="Completed" FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtPercentFresh" Text="100%" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Grid>
                                <ProgressBar x:Name="ProgressFresh" Minimum="0" Maximum="100" Value="0"/>
                            </StackPanel>
                        </Border>

                        <Border Height="14"/>

                        <!-- BLOQUE 3: OPCIÓN 2 -->
                        <Button x:Name="BtnCleanAndInstall" Style="{StaticResource PrepOptionButtonStyle}" Margin="0,0,0,0" Click="BtnCleanAndInstall_Click">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="CleanInstallTransform" Y="0"/>
                            </Button.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                    <TextBlock x:Name="TxtCleanTitle" Text="I already installed drivers or OEM utilities" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtCleanDesc" Text="Removes previous drivers and suites like Armoury Crate or GeForce Experience, reboots, and leaves a clean base."
                                               FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCleanAction" Text="Clean" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,8,0"/>
                                    <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#3474C6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Border x:Name="ProgressPanelClean" Visibility="Collapsed" Background="#07080C" BorderBrush="#1C1E28" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="28,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TxtStatusClean" Text="Completed" FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtPercentClean" Text="100%" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Grid>
                                <ProgressBar x:Name="ProgressClean" Minimum="0" Maximum="100" Value="0"/>
                            </StackPanel>
                        </Border>

                        <!-- BLOQUE 4: CONTINUACIÓN DIRECTA -->
                        <StackPanel x:Name="StepZeroSkipSection">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="SkipSectionTransform" Y="0"/>
                            </StackPanel.RenderTransform>

                            <Separator Background="#1C1E28" Margin="0,28,0,22"/>

                            <TextBlock x:Name="TxtAlreadyReadyPrompt" Text="Already have clean, configured drivers?"
                                       FontSize="15.5" FontWeight="Medium" Foreground="#E4E4EC" Margin="2,0,0,12"/>

                            <Button x:Name="BtnSkipDrivers" Style="{StaticResource PrepOptionButtonStyle}" Click="BtnSkipDrivers_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                        <TextBlock x:Name="TxtSkipTitle" Text="My drivers are already ready" FontSize="17.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="TxtSkipDesc" Text="Creates the mandatory preventive restore point and jumps straight into the system optimization panel."
                                                   FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSkipAction" Text="Continue" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,8,0"/>
                                        <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#3474C6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- BLOQUE 5: SECCIÓN INFERIOR -->
                        <StackPanel x:Name="StepZeroWhySection">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="WhySectionTransform" Y="0"/>
                            </StackPanel.RenderTransform>

                            <Separator Background="#1C1E28" Margin="0,32,0,26"/>

                            <TextBlock x:Name="TxtWhyTitle" Text="Why do we perform this step?" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="M12,2 L20,6 V12 C20,17.5 16.5,21.5 12,23 C7.5,21.5 4,17.5 4,12 V6 L12,2 Z"
                                              Stroke="#3474C6" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtWhy1Title" Text="Preventive backup" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtWhy1Desc" Text="Saves an exact snapshot of Windows before modifying any setting. Zero performance impact and uses at most 5% disk space."
                                               FontSize="14.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="M4,6 H20 V18 H4 Z M8,2 V6 M16,2 V6"
                                              Stroke="#3474C6" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtWhy2Title" Text="Bloat-free drivers" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtWhy2Desc" Text="Prevents Windows Update from pushing generic packages and prepares Chipset and GPU without background services."
                                               FontSize="14.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z"
                                              Stroke="#3474C6" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtWhy3Title" Text="Reversible tweaks" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtWhy3Desc" Text="Every adjustment lets you review its purpose and restore Windows defaults in a single click."
                                               FontSize="14.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- HUD FLOTANTE MINIMALISTA DE CARGA -->
                <Grid x:Name="PrepModalOverlay" Visibility="Collapsed" Background="#C8050609">
                    <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="104" Height="104" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Ellipse Width="104" Height="104" Stroke="#182236" StrokeThickness="2.2"/>
                            <Path Data="M52,2 A50,50 0 0,1 102,52" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="LoadingRingRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>

                            <Ellipse Width="74" Height="74" Stroke="#121A29" StrokeThickness="1.6"/>
                            <Path Data="M52,89 A37,37 0 0,1 15,52" Stroke="#255EA8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="LoadingInnerRingRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>

                            <Ellipse Width="8" Height="8" Fill="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="TxtModalStepTag" Text="STAGE 1 OF 3 · SYSTEM BACKUP"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#5D9BE6"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtModalTitle" Text="Preparing system"
                                   FontSize="25" FontWeight="SemiBold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock x:Name="TxtModalMessage" Text="Creating preventive system restore point..."
                                   FontSize="15.5" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,28"/>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="TxtModalProcessingLabel" Text="Processing configuration" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtModalPercent" Text="0%" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </Grid>

                        <ProgressBar x:Name="ModalProgressBar" Height="9" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>
                </Grid>

                <!-- MODAL DE INICIO DE SESIÓN / REGISTRO -->
                <Grid x:Name="AccountModalOverlay" Visibility="Collapsed" Background="#B8050609">
                    <Border Width="450" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#0B0D14" BorderBrush="#232B3D" BorderThickness="1" CornerRadius="8" Padding="28,24">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock x:Name="TxtAccountModalTitle" Text="Archon Account" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Button Content="✕" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" Padding="8,4" Click="BtnCloseAccountModal_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnTabSignIn" Content="Sign in" Style="{StaticResource PrimaryButtonStyle}" Padding="10,8" FontSize="13.5" Click="BtnTabSignIn_Click"/>
                                <Button Grid.Column="2" x:Name="BtnTabRegister" Content="Register" Style="{StaticResource SoftCardButtonStyle}" Padding="10,8" FontSize="13.5" Click="BtnTabRegister_Click"/>
                            </Grid>

                            <TextBlock x:Name="TxtAccountModalDesc" Text="Sign in to sync your optimization profiles, app presets, and cloud backups."
                                       FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>

                            <TextBlock x:Name="TxtAccountUserLabel" Text="Username or Email" FontSize="13.5" FontWeight="Medium" Foreground="#CBD2E3" Margin="0,0,0,6"/>
                            <Border Background="#07080C" BorderBrush="#1F2433" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
                                <TextBox x:Name="TxtAccountInput" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                         BorderThickness="0" Padding="12,10" FontSize="14.5"/>
                            </Border>

                            <StackPanel x:Name="PanelRegisterExtra" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock x:Name="TxtAccountPassLabel" Text="Password" FontSize="13.5" FontWeight="Medium" Foreground="#CBD2E3" Margin="0,0,0,6"/>
                                <Border Background="#07080C" BorderBrush="#1F2433" BorderThickness="1" CornerRadius="6">
                                    <PasswordBox x:Name="TxtAccountPassInput" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                                 BorderThickness="0" Padding="12,10" FontSize="14.5"/>
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" x:Name="BtnAccountSignOut" Content="Sign out" Style="{StaticResource SoftCardButtonStyle}" Padding="14,10" Click="BtnAccountSignOut_Click"/>
                                <Button Grid.Column="2" x:Name="BtnAccountSave" Content="Continue" Style="{StaticResource PrimaryButtonStyle}" Padding="14,10" Click="BtnAccountSave_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- VISTA 3: PANEL DE AJUSTES CON BARRA DE TELEMETRÍA Y PERFIL EN SIDEBAR -->
                <Grid x:Name="MainOptimizerView" Visibility="Collapsed" Margin="26,18,22,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="244"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- MENÚ LATERAL -->
                    <DockPanel Grid.Column="0" Margin="0,0,24,0">
                        <!-- TARJETA DE PERFIL CIRCULAR EN SIDEBAR -->
                        <Button x:Name="BtnSidebarProfile" DockPanel.Dock="Bottom" Style="{StaticResource SoftCardButtonStyle}"
                                HorizontalContentAlignment="Left" Padding="12,10" Margin="0,12,0,0" Click="BtnOpenSignIn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#121A2B" BorderBrush="#3B82F6" BorderThickness="1.5" Margin="0,0,10,0">
                                    <TextBlock x:Name="SidebarAvatarInitial" Text="A" FontSize="14" FontWeight="Bold" Foreground="#60A5FA"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSidebarUser" Text="Guest Profile" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtSidebarUserStatus" Text="Manage account" FontSize="11.5" Foreground="#8FA4C7"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <StackPanel x:Name="SidebarMenu">
                            <Button x:Name="BtnBackToStepZero" Style="{StaticResource GhostButtonStyle}"
                                    HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="BtnBackToStepZero_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,10.5 L12,3 L21,10.5 V20 H15 V14 H9 V20 H3 Z" Stroke="#D0D0DA" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="TxtNavPrep" Text="Preparation" FontWeight="SemiBold" Foreground="#E4E4EC"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnSidebarPerf" Style="{StaticResource GhostButtonStyle}"
                                    HorizontalContentAlignment="Left" Margin="0,0,0,14" Click="BtnOpenPerformance_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,13 H7 L10,5 L14,19 L17,11 H21" Stroke="#5D9BE6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="TxtNavPerf" Text="Performance" FontWeight="SemiBold" Foreground="#93C5FD"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnCatApps" Content="Apps" Tag="Apps" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                            <Button x:Name="BtnCatGaming" Content="Gaming &amp; Power" Tag="Gaming y Energía" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                            <Button x:Name="BtnCatNetwork" Content="Network &amp; DNS" Tag="Red y DNS" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                            <Button x:Name="BtnCatDebloat" Content="Debloat" Tag="Debloat" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                            <Button x:Name="BtnCatServices" Content="Services" Tag="Servicios" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                            <Button x:Name="BtnCatCleanup" Content="Cleanup" Tag="Limpieza" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- CONTENIDO CENTRAL -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- BARRA SUPERIOR DE TELEMETRÍA Y ESTADÍSTICAS EN VIVO -->
                        <Grid Grid.Row="0" Margin="0,0,22,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#CC090B12" BorderBrush="#1A2233" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock x:Name="TxtOptStatCpuLabel" Text="LIVE CPU" FontSize="11" FontWeight="Bold" Foreground="#5D9BE6"/>
                                        <TextBlock x:Name="TxtOptStatCpuVal" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar x:Name="OptStatCpuBar" Minimum="0" Maximum="100" Value="0" Height="4"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#CC090B12" BorderBrush="#1A2233" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock x:Name="TxtOptStatRamLabel" Text="MEMORY RAM" FontSize="11" FontWeight="Bold" Foreground="#A78BFA"/>
                                        <TextBlock x:Name="TxtOptStatRamVal" Text="0.0 GB" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar x:Name="OptStatRamBar" Foreground="#8B5CF6" Minimum="0" Maximum="100" Value="0" Height="4"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="#CC090B12" BorderBrush="#1A2233" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock x:Name="TxtOptStatSelLabel" Text="ACTIVE ITEMS" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                    <TextBlock x:Name="TxtOptStatSelVal" Text="0 selected" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6" Background="#CC090B12" BorderBrush="#1A2233" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock x:Name="TxtOptStatBackupLabel" Text="RESTORE GUARD" FontSize="11" FontWeight="Bold" Foreground="#FBBF24"/>
                                    <TextBlock x:Name="TxtOptStatBackupVal" Text="VSS Protected" FontSize="13.5" FontWeight="SemiBold" Foreground="#4CC38A" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- BUSCADOR -->
                        <Border Grid.Row="1" Background="#CC090A0F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Margin="0,0,22,14">
                            <Grid>
                                <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="#FFFFFF"
                                         CaretBrush="#FFFFFF" BorderThickness="0"
                                         Padding="16,12" FontSize="15" TextChanged="TxtSearch_TextChanged"/>
                                <TextBlock x:Name="TxtSearchPlaceholder" Text="Search tweak or application..." Foreground="{StaticResource TextMuted}" FontSize="15"
                                           Margin="17,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- LISTA AGRUPADA -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                            <ItemsControl x:Name="TweaksItemsControl">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,10,0,10">
                                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="#98A9C7"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Margin" Value="0,0,0,12"/>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#D9090A0F" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,9">
                                            <StackPanel>
                                                <Grid Margin="20,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"
                                                            Width="38" Height="38" CornerRadius="7" Background="#10131C" BorderBrush="#1F2433" BorderThickness="1"
                                                            Margin="0,0,15,0" VerticalAlignment="Center">
                                                        <Path Data="{Binding IconGeometry}" Fill="{Binding IconColor}"
                                                              Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15.5" FontWeight="Medium" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                    <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Padding="10,6" Margin="10,0" Tag="{Binding}" Click="BtnInfo_Click">
                                                        <TextBlock Text="ⓘ" FontSize="16" Foreground="#A6ACBE"/>
                                                    </Button>

                                                    <CheckBox Grid.Column="3" Style="{StaticResource ModernSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Click="TweakSwitch_Click"/>
                                                </Grid>

                                                <Border Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVis}}"
                                                        Background="#0D1019" BorderBrush="#1C2334" BorderThickness="0,1,0,0"
                                                        CornerRadius="0,0,6,6" Padding="20,14">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="3" CornerRadius="1.5" Background="#3B82F6" Margin="0,2,12,2"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="14.5" Foreground="#E4E8F2" TextWrapping="Wrap" LineHeight="21"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- BARRA INFERIOR -->
                        <Grid Grid.Row="3" Margin="0,14,22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="BtnRestoreOriginal" Content="Restore defaults" Style="{StaticResource SoftCardButtonStyle}" Padding="20,12" Click="BtnRestoreAll_Click"/>
                            <TextBlock x:Name="TxtActionFeedback" Grid.Column="1" Text="" FontSize="14.5" FontWeight="SemiBold" Foreground="#4CC38A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0"/>
                            <Button Grid.Column="2" x:Name="BtnApplyChanges" Content="Apply changes" Style="{StaticResource PrimaryButtonStyle}" Padding="26,12" Click="BtnApplyChanges_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
