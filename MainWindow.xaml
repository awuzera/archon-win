<Window x:Class="Archon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCHON v1.0"
        Height="660" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D10"
        Foreground="#F2F2F5"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgPanel" Color="#14141A"/>
        <SolidColorBrush x:Key="BgPanelHover" Color="#1B1B23"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#25252F"/>
        <SolidColorBrush x:Key="BorderHover" Color="#3A3A48"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#C83741"/>
        <SolidColorBrush x:Key="AccentPrimaryHover" Color="#DC434E"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A8A8B3"/>
        <SolidColorBrush x:Key="TextMuted" Color="#747482"/>

        <!-- SCROLLBAR OSCURO DELGADO -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2E2E3A" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTONES DE VENTANA -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9E9EA9"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D1D25"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B82D35"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PANEL / BOTÓN DE SUPERFICIE NATIVA -->
        <Style x:Key="SoftCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="#F2F2F5"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgPanelHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FILA INTERACTIVA CON INDICADOR LATERAL PARA PREPARACIÓN -->
        <Style x:Key="ActionRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F2F2F5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBg" Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="LeftAccent" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                                <Border Padding="24,18">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#181820"/>
                                <Setter TargetName="LeftAccent" Property="Background" Value="#C83741"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RowBg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN DE NAVEGACIÓN DISCRETO -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#191921"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SWITCH LIMPIO -->
        <Style x:Key="ModernSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="44" Height="22" CornerRadius="4" Background="#24242E">
                            <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="2" Margin="3,0" HorizontalAlignment="Left" Background="#8E8E9B"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentPrimary}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#202028" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0B0E" Offset="0"/>
                <GradientStop Color="#101016" Offset="0.55"/>
                <GradientStop Color="#0C0C11" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- FONDO DIFUMINADO SUTIL -->
            <Grid Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="680" Height="360" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-140,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#26C83741" Offset="0"/>
                            <GradientStop Color="#0DC83741" Offset="0.55"/>
                            <GradientStop Color="#00C83741" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="95"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse Width="580" Height="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-140,-120">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1E4A5491" Offset="0"/>
                            <GradientStop Color="#004A5491" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="100"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <!-- BARRA SUPERIOR -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                        <Canvas Width="64" Height="64">
                            <Path Data="M32,4 L58,18 L58,46 L32,60 L6,46 L6,18 Z" Fill="#1E1417" Stroke="#C83741" StrokeThickness="3.5"/>
                            <Path Data="M32,14 L48,48 L40,48 L32,30 L24,48 L16,48 Z" Fill="#FFFFFF"/>
                            <Polygon Points="32,37 37,46 27,46" Fill="#C83741"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Archon" FontWeight="SemiBold" FontSize="14.5" Foreground="#F2F2F5" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Style="{StaticResource WindowControlButtonStyle}" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- VISTA 1: PRESENTACIÓN CON TABLA DE COMPONENTES CORREGIDA -->
            <ScrollViewer x:Name="WelcomeView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,16,32,32">

                    <!-- LOGO ARCHON -->
                    <Viewbox Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Canvas Width="64" Height="64">
                            <Path Data="M32,3 L59,18 L59,46 L32,61 L5,46 L5,18 Z" Fill="#16161D" Stroke="#2D2D38" StrokeThickness="2"/>
                            <Path Data="M32,12 L50,49 L41.5,49 L32,28.5 L22.5,49 L14,49 Z" Fill="#FFFFFF"/>
                            <Polygon Points="32,36 38,48 26,48" Fill="#C83741"/>
                        </Canvas>
                    </Viewbox>

                    <TextBlock Text="Archon" FontSize="38" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <TextBlock Text="Bienvenido" FontSize="17" Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <!-- BOTONES PRINCIPALES -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                        <Button x:Name="BtnStartStepZero" Style="{StaticResource PrimaryButtonStyle}" Padding="32,13" Margin="0,0,12,0" Click="BtnStartStepZero_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Comenzar" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="10,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnScanHardware" Style="{StaticResource SoftCardButtonStyle}" Padding="22,13" Click="BtnScanHardware_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M9,2 V5 M15,2 V5 M9,19 V22 M15,19 V22 M2,9 H5 M2,15 H5 M19,9 H22 M19,15 H22 M6,5 H18 A1,1 0 0 1 19,6 V18 A1,1 0 0 1 18,19 H6 A1,1 0 0 1 5,18 V6 A1,1 0 0 1 6,5 Z M9,9 H15 V15 H9 Z"
                                      Stroke="#A8A8B3" StrokeThickness="1.7" Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtScanButtonLabel" Text="Ver mis componentes" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- PANEL INTERACTIVO DE HARDWARE CON COLUMNAS SEPARADAS -->
                    <Border x:Name="HardwareListPanel" Visibility="Collapsed" MinWidth="560" Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="5" Padding="24,20">
                        <StackPanel>
                            <TextBlock Text="Componentes detectados" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Procesador" FontSize="14.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCpuValue" Text="Detectando..." FontSize="14.5" Foreground="#F2F2F5" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>
                            <Separator Background="#202029" Margin="0,0,0,11"/>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Placa madre" FontSize="14.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TxtMotherValue" Text="Detectando..." FontSize="14.5" Foreground="#F2F2F5" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>
                            <Separator Background="#202029" Margin="0,0,0,11"/>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tarjeta gráfica" FontSize="14.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TxtGpuValue" Text="Detectando..." FontSize="14.5" Foreground="#F2F2F5" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>
                            <Separator Background="#202029" Margin="0,0,0,11"/>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Memoria RAM" FontSize="14.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TxtRamValue" Text="Detectando..." FontSize="14.5" Foreground="#F2F2F5" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>
                            <Separator Background="#202029" Margin="0,0,0,11"/>

                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Almacenamiento" FontSize="14.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TxtStorageValue" Text="Detectando..." FontSize="14.5" Foreground="#F2F2F5" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>
                            <Separator Background="#202029" Margin="0,0,0,11"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sistema operativo" FontSize="14.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TxtOsValue" Text="Detectando..." FontSize="14.5" Foreground="#F2F2F5" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- VISTA 2: PREPARACIÓN DEL SISTEMA (DISEÑO SECUENCIAL CON IDENTIDAD PROPIA) -->
            <ScrollViewer x:Name="StepZeroView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="820" HorizontalAlignment="Center" Margin="32,8,32,40">

                    <!-- BOTÓN INICIO -->
                    <Button x:Name="BtnBackToWelcome" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="-10,0,0,14" Click="BtnBackToWelcome_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,10.5 L12,3 L21,10.5 V20 A1,1 0 0 1 20,21 H15 V14 H9 V21 H4 A1,1 0 0 1 3,20 Z"
                                  Stroke="#A8A8B3" StrokeThickness="1.7" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Inicio" FontSize="14.5" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ENCABEZADO -->
                    <TextBlock Text="Preparación del sistema" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>

                    <TextBlock Text="Elegí cómo querés preparar la base de Windows antes de pasar al panel de ajustes."
                               FontSize="15.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,22"/>

                    <!-- AVISO DE BLOATWARE DETECTADO -->
                    <Border x:Name="BloatAlertBox" Visibility="Collapsed" Background="#1D1418" BorderBrush="#3A2228" BorderThickness="1" CornerRadius="4" Padding="18,13" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12,3 L22,20 H2 Z M12,9 V13 M12,17 H12.01" Stroke="#E06C75" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,1,12,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="Software adicional de fabricante detectado" FontSize="14.5" FontWeight="SemiBold" Foreground="#E5737B" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtDetectedBloatList" Text="" FontSize="14" Foreground="#D4D4DC" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SELECTOR SECUENCIAL NUMERADO (01 / 02 / 03) -->
                    <Border Background="#121217" BorderBrush="#23232E" BorderThickness="1" CornerRadius="4" Margin="0,0,0,18">
                        <StackPanel>
                            <!-- RUTA 01 -->
                            <Button x:Name="BtnFreshInstall" Style="{StaticResource ActionRowButtonStyle}" Click="BtnFreshInstall_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="01" FontSize="16" FontWeight="Bold" Foreground="#C83741" VerticalAlignment="Top" Margin="0,2,0,0"/>

                                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                        <TextBlock Text="Windows recién instalado" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                        <TextBlock Text="Crea el punto de restauración preventivo e instala únicamente los controladores esenciales sin telemetría ni paneles extra."
                                                   FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Instalar" FontSize="14" FontWeight="SemiBold" Foreground="#D4D4DC" Margin="0,0,8,0"/>
                                        <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#C83741" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Border Height="1" Background="#1F1F28"/>

                            <!-- RUTA 02 -->
                            <Button x:Name="BtnCleanAndInstall" Style="{StaticResource ActionRowButtonStyle}" Click="BtnCleanAndInstall_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="02" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Top" Margin="0,2,0,0"/>

                                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                        <TextBlock Text="Ya instalé drivers o utilidades de fabricante" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                        <TextBlock Text="Limpia controladores previos y programas como Armoury Crate o GeForce Experience, reinicia el equipo y deja la base limpia."
                                                   FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Limpiar" FontSize="14" FontWeight="SemiBold" Foreground="#A8A8B3" Margin="0,0,8,0"/>
                                        <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#A8A8B3" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Border Height="1" Background="#1F1F28"/>

                            <!-- RUTA 03 -->
                            <Button x:Name="BtnSkipDrivers" Style="{StaticResource ActionRowButtonStyle}" Click="BtnSkipDrivers_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="03" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Top" Margin="0,2,0,0"/>

                                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                        <TextBlock Text="Ya tengo mis controladores listos" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                        <TextBlock Text="Genera el respaldo preventivo obligatorio y pasa directamente al panel de ajustes del sistema."
                                                   FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Continuar" FontSize="14" FontWeight="SemiBold" Foreground="#A8A8B3" Margin="0,0,8,0"/>
                                        <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#A8A8B3" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- BARRA DE ESTADO INTEGRADA SIN CAJA -->
                    <StackPanel Margin="2,0,2,26">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="7" Height="7" Fill="#C83741" Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStepZeroStatus" Text="Listo para comenzar"
                                       FontSize="13.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ProgressBar x:Name="StepZeroProgress" Height="4" Minimum="0" Maximum="100" Value="0"
                                     Background="#1D1D26" Foreground="{StaticResource AccentPrimary}" BorderThickness="0"/>
                    </StackPanel>

                    <!-- SECCIÓN INFERIOR: ¿POR QUÉ HACEMOS ESTE PASO? -->
                    <Separator Background="#202029" Margin="0,6,0,26"/>

                    <TextBlock Text="¿Por qué hacemos este paso?" FontSize="19" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="M12,2 L20,6 V12 C20,17.5 16.5,21.5 12,23 C7.5,21.5 4,17.5 4,12 V6 L12,2 Z"
                                      Stroke="#C83741" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Respaldo preventivo" FontSize="15.5" FontWeight="SemiBold" Foreground="#F2F2F5"/>
                            </StackPanel>
                            <TextBlock Text="Guarda una copia exacta del estado actual de Windows antes de tocar cualquier clave. No consume rendimiento y usa como máximo el 5% del disco."
                                       FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="M4,6 H20 V18 H4 Z M8,2 V6 M16,2 V6"
                                      Stroke="#C83741" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Drivers sin basura" FontSize="15.5" FontWeight="SemiBold" Foreground="#F2F2F5"/>
                            </StackPanel>
                            <TextBlock Text="Evita que Windows Update instale paquetes genéricos y prepara Chipset y GPU sin servicios corriendo en segundo plano."
                                       FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z"
                                      Stroke="#C83741" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Cambios reversibles" FontSize="15.5" FontWeight="SemiBold" Foreground="#F2F2F5"/>
                            </StackPanel>
                            <TextBlock Text="Cada ajuste permite revisar qué modifica en el Registro y volver al estado original de Windows en un clic."
                                       FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="21"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- VISTA 3: PANEL DE AJUSTES -->
            <Grid x:Name="MainOptimizerView" Grid.Row="1" Visibility="Collapsed" Margin="20,10,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MENÚ LATERAL -->
                <StackPanel x:Name="SidebarMenu" Grid.Column="0" Margin="0,0,18,0">
                    <Button x:Name="BtnBackToStepZero" Style="{StaticResource GhostButtonStyle}"
                            HorizontalContentAlignment="Left" Margin="0,0,0,14" Click="BtnBackToStepZero_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,10.5 L12,3 L21,10.5 V20 H15 V14 H9 V20 H3 Z" Stroke="#A8A8B3" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0"/>
                            <TextBlock Text="Preparación" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Button>

                    <Button Content="Instalador Día 0" Tag="Instalador Día 0" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Content="Gaming y Energía" Tag="Gaming y Energía" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Content="Red y DNS" Tag="Red y DNS" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Content="Debloat" Tag="Debloat" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Content="Servicios" Tag="Servicios" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                    <Button Content="Limpieza" Tag="Limpieza" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="14,10" Margin="0,0,0,6" Click="CategoryBtn_Click"/>
                </StackPanel>

                <!-- CONTENIDO CENTRAL -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BUSCADOR -->
                    <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,14">
                        <Grid>
                            <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="#FFFFFF"
                                     CaretBrush="#FFFFFF" BorderThickness="0"
                                     Padding="14,11" FontSize="14.5" TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock Text="Buscar ajuste..." Foreground="{StaticResource TextMuted}" FontSize="14.5"
                                       Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- LISTA DE AJUSTES -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TweaksItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="5" Padding="18,14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="15" FontWeight="Medium" Foreground="#F2F2F5" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                            <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Padding="10,6" Margin="10,0" Tag="{Binding}" Click="BtnInfo_Click">
                                                <TextBlock Text="ⓘ" FontSize="15" Foreground="{StaticResource TextMuted}"/>
                                            </Button>

                                            <CheckBox Grid.Column="2" Style="{StaticResource ModernSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- INSPECTOR DE DETALLE -->
                    <Border x:Name="InspectorPanel" Grid.Row="2" Visibility="Collapsed" Background="#16161E" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="5" Padding="18,14" Margin="0,10,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtInspectorTitle" FontSize="14.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtInspectorDesc" FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtInspectorTech" FontSize="13" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Cerrar" Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Top" Margin="12,0,0,0" Click="BtnCloseInspector_Click"/>
                        </Grid>
                    </Border>

                    <!-- BARRA INFERIOR -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Restaurar original" Style="{StaticResource SoftCardButtonStyle}" Padding="18,11" Click="BtnRestoreAll_Click"/>
                        <TextBlock x:Name="TxtActionFeedback" Grid.Column="1" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#4CC38A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0"/>
                        <Button Grid.Column="2" Content="Aplicar cambios" Style="{StaticResource PrimaryButtonStyle}" Padding="24,11" Click="BtnApplyChanges_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
