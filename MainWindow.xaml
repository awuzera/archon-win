cat << 'EOF' > MainWindow.xaml
<Window x:Class="Archon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCHON v1.0"
        Height="780" Width="1180"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0D"
        Foreground="#F2F2F5"
        FontFamily="Consolas, Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgMain" Color="#0B0B0D"/>
        <SolidColorBrush x:Key="BgCard" Color="#131317"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#1B1B22"/>
        <SolidColorBrush x:Key="BorderDark" Color="#272730"/>
        <SolidColorBrush x:Key="AccentRed" Color="#D9232E"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#F02E3A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9E9EA9"/>

        <Style x:Key="PrimaryRedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentRed}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentRedHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RawButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="#EAEAEF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgCardHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TweakSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="74" Height="30" Background="#1A1A20" BorderBrush="#343440" BorderThickness="1">
                            <Grid>
                                <Border x:Name="Thumb" Width="32" Height="22" Margin="3,0" HorizontalAlignment="Left" Background="#4C4C58"/>
                                <TextBlock x:Name="StateText" Text="OFF" FontSize="11" FontWeight="Bold" Foreground="#8C8C99"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3D1216"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Background" Value="{StaticResource AccentRed}"/>
                                <Setter TargetName="StateText" Property="Text" Value="ON"/>
                                <Setter TargetName="StateText" Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="StateText" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="StateText" Property="Margin" Value="9,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA DE TÍTULO -->
            <Grid Grid.Row="0" Background="#08080A">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Rectangle Width="11" Height="11" Fill="{StaticResource AccentRed}" Margin="0,0,10,0"/>
                    <TextBlock Text="ARCHON v1.0 // PREPARACIÓN Y OPTIMIZACIÓN DE SISTEMA" FontWeight="Bold" FontSize="13" Foreground="#F2F2F5"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Width="42" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Click="Minimize_Click" Cursor="Hand"/>
                    <Button Content="▢" Width="42" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Click="Maximize_Click" Cursor="Hand"/>
                    <Button Content="✕" Width="42" Background="Transparent" Foreground="#FF5555" BorderThickness="0" Click="Close_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- PANEL COMPLETO DE HARDWARE DETECTADO -->
            <Border Grid.Row="1" Background="#0F0F13" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,1" Padding="18,12">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="11,6" Margin="4">
                        <TextBlock x:Name="TxtCpuBadge" Text="[ CPU: Escaneando... ]" FontSize="12.5" Foreground="#E6E6EC"/>
                    </Border>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="11,6" Margin="4">
                        <TextBlock x:Name="TxtMotherBadge" Text="[ MOTHER: Escaneando... ]" FontSize="12.5" Foreground="#E6E6EC"/>
                    </Border>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="11,6" Margin="4">
                        <TextBlock x:Name="TxtGpuBadge" Text="[ GPU: Escaneando... ]" FontSize="12.5" Foreground="#E6E6EC"/>
                    </Border>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="11,6" Margin="4">
                        <TextBlock x:Name="TxtRamBadge" Text="[ RAM: Escaneando... ]" FontSize="12.5" Foreground="#E6E6EC"/>
                    </Border>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="11,6" Margin="4">
                        <TextBlock x:Name="TxtStorageBadge" Text="[ DISCO: Escaneando... ]" FontSize="12.5" Foreground="#E6E6EC"/>
                    </Border>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="11,6" Margin="4">
                        <TextBlock x:Name="TxtOsBadge" Text="[ SO: Escaneando... ]" FontSize="12.5" Foreground="#E6E6EC"/>
                    </Border>
                </WrapPanel>
            </Border>

            <!-- VISTA PRINCIPAL: PASO 0 CENTRADO CON SCROLL VERTICAL -->
            <ScrollViewer x:Name="StepZeroView" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,28">
                <StackPanel MaxWidth="860" HorizontalAlignment="Center">

                    <!-- CABECERA CENTRADA -->
                    <TextBlock Text="[ PASO 0 // PREPARACIÓN DE BASE Y DRIVERS ]"
                               FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentRed}"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock Text="Antes de aplicar cualquier optimización, aseguramos tu Windows con un respaldo completo y preparamos controladores limpios sin software basura."
                               FontSize="15" Foreground="#D4D4DC" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" LineHeight="22" Margin="0,0,0,22"/>

                    <!-- ALERTA DE BLOATWARE DETECTADO -->
                    <Border x:Name="BloatAlertBox" Visibility="Collapsed" Background="#261013" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" Padding="16,12" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="[ ! ] SOFTWARE BASURA DE FABRICANTE DETECTADO EN ESTE EQUIPO:" FontSize="13.5" FontWeight="Bold" Foreground="#FF6B74" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtDetectedBloatList" Text="" FontSize="13.5" Foreground="#F2F2F5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- BLOQUE CENTRAL PRINCIPAL -->
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="28,26">
                        <StackPanel>
                            <TextBlock Text="SELECCIONÁ EL ESTADO ACTUAL DE TU PC"
                                       FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20"/>

                            <!-- OPCIÓN A -->
                            <Button x:Name="BtnFreshInstall" Style="{StaticResource PrimaryRedButtonStyle}"
                                    HorizontalContentAlignment="Stretch" Padding="22,18" Margin="0,0,0,14" Click="BtnFreshInstall_Click">
                                <StackPanel>
                                    <TextBlock Text="[ OPCIÓN A: WINDOWS RECIÉN INSTALADO ]" FontSize="16.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock Text="No instalé drivers todavía. Crear punto de seguridad obligatorio e instalar únicamente controladores limpios (Chipset + GPU sin telemetría)."
                                               FontSize="14" FontWeight="Normal" Foreground="#F5EAEA" TextWrapping="Wrap" LineHeight="20"/>
                                </StackPanel>
                            </Button>

                            <!-- OPCIÓN B -->
                            <Button x:Name="BtnCleanAndInstall" Style="{StaticResource RawButtonStyle}"
                                    HorizontalContentAlignment="Stretch" Padding="22,18" Margin="0,0,0,22" Click="BtnCleanAndInstall_Click">
                                <StackPanel>
                                    <TextBlock Text="[ OPCIÓN B: YA INSTALÉ DRIVERS / BLOAT ]" FontSize="16.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock Text="Limpiar drivers anteriores y basura de fabricantes (Armoury Crate, GeForce Experience), reiniciar y dejar la base limpia."
                                               FontSize="14" Foreground="#C4C4CE" TextWrapping="Wrap" LineHeight="20"/>
                                </StackPanel>
                            </Button>

                            <!-- ESTADO EN VIVO Y PROGRESO -->
                            <Border Background="#0B0B0D" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="16,14" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock x:Name="TxtStepZeroStatus" Text="ESTADO: Esperando selección..."
                                               FontSize="14" FontWeight="Bold" Foreground="#E4E4EC" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <ProgressBar x:Name="StepZeroProgress" Height="12" Minimum="0" Maximum="100" Value="0"
                                                 Background="#17171D" Foreground="{StaticResource AccentRed}" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- SALTAR DIRECTO AL OPTIMIZADOR -->
                            <Button x:Name="BtnSkipDrivers" Style="{StaticResource RawButtonStyle}"
                                    HorizontalAlignment="Center" Padding="22,12" Click="BtnSkipDrivers_Click">
                                <TextBlock Text="[ Ya tengo mis drivers limpios -> Ir al Optimizador ]" FontSize="14.5" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- SECCIÓN INFERIOR AL SCROLLEAR: EL PORQUÉ Y SEGURIDAD OBLIGATORIA -->
                    <Border Background="#0F0F13" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="28,24" Margin="0,24,0,16">
                        <StackPanel>
                            <TextBlock Text="[ ¿POR QUÉ HACEMOS ESTO? // SEGURIDAD OBLIGATORIA ]"
                                       FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentRed}" Margin="0,0,0,16"/>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="1. Punto de Restauración automático antes de tocar nada" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="Al elegir cualquier opción, Archon guarda primero una instantánea exacta del estado de tu Windows. No consume FPS, no deja procesos corriendo en segundo plano y está limitado automáticamente al 5% del disco para que puedas volver atrás en 2 clics."
                                           FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="21"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="2. Bloqueo de drivers automáticos de Windows Update" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="Evita que Windows instale versiones viejas o paneles DCH cargados de servicios innecesarios mientras preparás tus controladores limpios."
                                           FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="21"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="3. Auditoría transparente clave por clave" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock Text="Cada ajuste del optimizador permite inspeccionar exactamente qué ruta del Registro modifica antes de aplicarlo, con respaldo individual y restauración completa."
                                           FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="21"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- VISTA SECUNDARIA: PANEL DE OPTIMIZACIÓN Y TWEAKS -->
            <Grid x:Name="MainOptimizerView" Grid.Row="2" Visibility="Collapsed" Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MENÚ LATERAL -->
                <StackPanel x:Name="SidebarMenu" Grid.Column="0" Margin="0,0,16,0">
                    <Button x:Name="BtnBackToStepZero" Style="{StaticResource RawButtonStyle}"
                            HorizontalContentAlignment="Left" Margin="0,0,0,16" Click="BtnBackToStepZero_Click">
                        <TextBlock Text="← Volver a Paso 0" FontWeight="Bold" Foreground="#FF6B74"/>
                    </Button>

                    <Button Content="> Instalador Día 0" Tag="Instalador Día 0" Style="{StaticResource PrimaryRedButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="CategoryBtn_Click"/>
                    <Button Content="> Gaming y Energía" Tag="Gaming y Energía" Style="{StaticResource RawButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="CategoryBtn_Click"/>
                    <Button Content="> Red y DNS" Tag="Red y DNS" Style="{StaticResource RawButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="CategoryBtn_Click"/>
                    <Button Content="> Debloat" Tag="Debloat" Style="{StaticResource RawButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="CategoryBtn_Click"/>
                    <Button Content="> Servicios" Tag="Servicios" Style="{StaticResource RawButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="CategoryBtn_Click"/>
                    <Button Content="> Limpieza" Tag="Limpieza" Style="{StaticResource RawButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="CategoryBtn_Click"/>
                </StackPanel>

                <!-- CONTENIDO CENTRAL -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BARRA DE BÚSQUEDA Y PERFILES -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <TextBox x:Name="TxtSearch" Background="{StaticResource BgCard}" Foreground="#FFFFFF"
                                     CaretBrush="#FFFFFF" BorderBrush="{StaticResource BorderDark}" BorderThickness="1"
                                     Padding="12,10" FontSize="13.5" TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock Text="Buscar tweak, servicio o ajuste..." Foreground="#686875" FontSize="13.5"
                                       Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="1" Content="[ Importar Perfil ]" Style="{StaticResource RawButtonStyle}" Margin="0,0,10,0" Click="BtnImportProfile_Click"/>
                        <Button Grid.Column="2" Content="[ Exportar JSON ]" Style="{StaticResource RawButtonStyle}" Click="BtnExportProfile_Click"/>
                    </Grid>

                    <!-- LISTA DE TWEAKS -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TweaksItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="16,13" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="14.5" FontWeight="Bold" Foreground="#F2F2F5" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                            <Border Grid.Column="1" Padding="9,4" Margin="12,0" BorderThickness="1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#2EA043"/>
                                                        <Setter Property="Background" Value="#0E2414"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RiskLevel}" Value="RECOMENDADO">
                                                                <Setter Property="BorderBrush" Value="#D29922"/>
                                                                <Setter Property="Background" Value="#261D0B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding RiskLevel, StringFormat='[ {0} ]'}"/>
                                                            <Setter Property="Foreground" Value="#3FB950"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RiskLevel}" Value="RECOMENDADO">
                                                                    <Setter Property="Foreground" Value="#E3B341"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Button Grid.Column="2" Content="[ i ]" Style="{StaticResource RawButtonStyle}" Padding="11,6" Margin="0,0,12,0" Tag="{Binding}" Click="BtnInfo_Click"/>
                                            <CheckBox Grid.Column="3" Style="{StaticResource TweakSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- PANEL INSPECTOR DE AUDITORÍA -->
                    <Border x:Name="InspectorPanel" Grid.Row="2" Visibility="Collapsed" Background="#101015" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" Padding="16,14" Margin="0,10,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtInspectorTitle" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentRed}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtInspectorDesc" FontSize="13.5" Foreground="#E4E4EC" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtInspectorTech" FontSize="12.5" Foreground="#9E9EA9" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="[ Cerrar ]" Style="{StaticResource RawButtonStyle}" VerticalAlignment="Top" Margin="12,0,0,0" Click="BtnCloseInspector_Click"/>
                        </Grid>
                    </Border>

                    <!-- BARRA INFERIOR DE ACCIÓN -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="[ Restaurar original ]" Style="{StaticResource RawButtonStyle}" Click="BtnRestoreAll_Click"/>
                        <TextBlock x:Name="TxtActionFeedback" Grid.Column="1" Text="" FontSize="13.5" FontWeight="Bold" Foreground="#3FB950"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0"/>
                        <Button Grid.Column="2" Content="[ APLICAR CAMBIOS ]" Style="{StaticResource PrimaryRedButtonStyle}" Padding="22,12" Click="BtnApplyChanges_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
EOF
