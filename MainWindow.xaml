<Window x:Class="Archon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCHON v1.0"
        Height="820" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#07070A"
        Foreground="#F5F5F8"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0" CornerRadius="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TopBarUtilityButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0E111A"/>
            <Setter Property="Foreground" Value="#D4D6E0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#1F2433" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#171C2B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#345080"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LangMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D6E0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#182236"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1A1C26" BorderThickness="1" CornerRadius="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#06070B" Offset="0"/>
                <GradientStop Color="#090D17" Offset="0.5"/>
                <GradientStop Color="#06070B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR CON EMBLEMA Y DESPLEGABLE DE IDIOMA -->
            <Border Grid.Row="0" Background="#050507" BorderBrush="#12141C" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <Viewbox Width="24" Height="24" Margin="0,0,10,0">
                            <Canvas Width="64" Height="64">
                                <Ellipse Canvas.Left="4" Canvas.Top="4" Width="56" Height="56" Stroke="#1D3B6E" StrokeThickness="1.5" StrokeDashArray="4 2"/>
                                <Path Data="M26,24 L14,12 L7,6 M38,24 L50,12 L57,6" Stroke="#3B82F6" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="M23,29 L9,23 L3,17 M41,29 L55,23 L61,17" Stroke="#3B82F6" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="M23,35 L9,41 L3,48 M41,35 L55,41 L61,48" Stroke="#3B82F6" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Data="M26,40 L15,52 L8,59 M38,40 L49,52 L56,59" Stroke="#3B82F6" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Polygon Points="32,14 39,22 32,29 25,22" Fill="#FFFFFF"/>
                                <Polygon Points="32,29 42,41 32,54 22,41" Fill="#122E59" Stroke="#FFFFFF" StrokeThickness="2.1" StrokeLineJoin="Round"/>
                                <TextBlock Canvas.Left="27.5" Canvas.Top="34.5" Text="Σ" FontSize="11" FontWeight="Bold" Foreground="#93C5FD"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Archon" FontWeight="SemiBold" FontSize="15" Foreground="#F5F5F8" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.0" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnLanguageDropdown" Style="{StaticResource TopBarUtilityButtonStyle}" Margin="0,0,10,0" Click="BtnLanguageDropdown_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2 A10,10 0 1,0 22,12 A10,10 0 0,0 12,2 Z M2,12 H22 M12,2 C14.8,5 16,8.4 16,12 C16,15.6 14.8,19 12,22 C9.2,19 8,15.6 8,12 C8,8.4 9.2,5 12,2 Z"
                                      Stroke="#5D9BE6" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCurrentLangCode" Text="EN" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <Path Data="M6,9 L12,15 L18,9" Stroke="#A6ACBE" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" Margin="6,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Popup x:Name="LanguagePopup" PlacementTarget="{Binding ElementName=BtnLanguageDropdown}"
                               Placement="Bottom" HorizontalOffset="-48" VerticalOffset="6"
                               StaysOpen="False" AllowsTransparency="True">
                            <Border Background="#0B0E17" BorderBrush="#26334D" BorderThickness="1" CornerRadius="7" Padding="6" Width="154">
                                <StackPanel>
                                    <Button x:Name="BtnLangEn" Content="🇺🇸  English (EN)" Tag="EN" Style="{StaticResource LangMenuItemStyle}" Click="LanguageOption_Click"/>
                                    <Button x:Name="BtnLangEs" Content="🇪🇸  Español (ES)" Tag="ES" Style="{StaticResource LangMenuItemStyle}" Click="LanguageOption_Click"/>
                                    <Button x:Name="BtnLangJa" Content="🇯🇵  日本語 (JA)" Tag="JA" Style="{StaticResource LangMenuItemStyle}" Click="LanguageOption_Click"/>
                                    <Button x:Name="BtnLangRu" Content="🇷🇺  Русский (RU)" Tag="RU" Style="{StaticResource LangMenuItemStyle}" Click="LanguageOption_Click"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Button Content="—" Style="{StaticResource WindowControlButtonStyle}" Click="Minimize_Click"/>
                        <Button Content="✕" Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENEDOR PRINCIPAL DE VISTAS -->
            <Grid Grid.Row="1">

                <!-- ILUMINACIÓN AMBIENTAL DE FONDO -->
                <Grid x:Name="AmbientGlowLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="AuroraTop" Width="1560" Height="720" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-140,-180,-140,0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AuroraTopTransform" X="0" Y="0"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.58" RadiusY="0.68">
                                <GradientStop Color="#661D57A6" Offset="0.0"/>
                                <GradientStop Color="#3B184585" Offset="0.36"/>
                                <GradientStop Color="#1611305E" Offset="0.70"/>
                                <GradientStop Color="#0011305E" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle x:Name="AuroraCenter" Width="1200" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AuroraCenterTransform" X="0" Y="0"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.52" RadiusY="0.55">
                                <GradientStop Color="#382563EB" Offset="0.0"/>
                                <GradientStop Color="#1A1B4985" Offset="0.45"/>
                                <GradientStop Color="#001B4985" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle x:Name="AuroraBottom" Width="1560" Height="700" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-140,0,-140,-210">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AuroraBottomTransform" X="0" Y="0"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.65" GradientOrigin="0.5,0.65" RadiusX="0.60" RadiusY="0.68">
                                <GradientStop Color="#5219498A" Offset="0.0"/>
                                <GradientStop Color="#2B143A6E" Offset="0.42"/>
                                <GradientStop Color="#100F2A52" Offset="0.74"/>
                                <GradientStop Color="#000F2A52" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- VISTA 1: PRESENTACIÓN CON AVATAR CIRCULAR, SELECTOR DE PERFIL Y TUERCA -->
                <ScrollViewer x:Name="WelcomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="28,18,28,36">

                        <!-- BARRA DE IDENTIDAD + PERFIL ACTIVO + CONFIGURACIÓN GENERAL -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <!-- FOTO CIRCULAR DE PERFIL (AL CLIC ABRE MI PERFIL) -->
                            <Button x:Name="BtnWelcomeAvatar" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnOpenMyProfile_Click">
                                <Border Width="44" Height="44" CornerRadius="22" Background="#101829" BorderBrush="#3B82F6" BorderThickness="1.8">
                                    <Grid>
                                        <Ellipse Margin="2">
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="WelcomeAvatarBrush" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock x:Name="WelcomeAvatarInitial" Text="A" FontSize="16" FontWeight="Bold" Foreground="#60A5FA"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- SELECTOR DESPLEGABLE DE PERFIL ACTIVO -->
                            <Button x:Name="BtnProfileDropdown" Style="{StaticResource SoftCardButtonStyle}" Padding="14,9" Margin="0,0,10,0" Click="BtnProfileDropdown_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtProfilePrefix" Text="Profile:" FontSize="13" Foreground="#8C97AD" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtActiveProfileName" Text="Predeterminado" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <Path Data="M6,9 L12,15 L18,9" Stroke="#8C97AD" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" Margin="8,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=BtnProfileDropdown}"
                                   Placement="Bottom" HorizontalOffset="0" VerticalOffset="6"
                                   StaysOpen="False" AllowsTransparency="True">
                                <Border Background="#0B0E17" BorderBrush="#26334D" BorderThickness="1" CornerRadius="7" Padding="6" Width="210">
                                    <StackPanel>
                                        <Button Content="⚡  Predeterminado" Tag="Predeterminado" Style="{StaticResource LangMenuItemStyle}" Click="SelectOptimizationProfile_Click"/>
                                        <Button Content="🎮  Gaming Competitivo" Tag="Gaming Competitivo" Style="{StaticResource LangMenuItemStyle}" Click="SelectOptimizationProfile_Click"/>
                                        <Button Content="💻  Trabajo / Desarrollo" Tag="Trabajo / Desarrollo" Style="{StaticResource LangMenuItemStyle}" Click="SelectOptimizationProfile_Click"/>
                                        <Button Content="🔇  Silencioso / Bajo Consumo" Tag="Silencioso / Bajo Consumo" Style="{StaticResource LangMenuItemStyle}" Click="SelectOptimizationProfile_Click"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- TUERCA DE CONFIGURACIÓN GENERAL -->
                            <Button x:Name="BtnOpenGeneralSettings" Style="{StaticResource SoftCardButtonStyle}" Width="42" Height="42" Padding="0" Click="BtnOpenGeneralSettings_Click">
                                <Path Data="M12,8.5 A3.5,3.5 0 1,0 15.5,12 A3.5,3.5 0 0,0 12,8.5 Z M19.4,13 L21.5,14.6 L19.8,17.5 L17.3,16.5 A7.6,7.6 0 0,1 15.7,17.4 L15.3,20 H12 L11.6,17.4 A7.6,7.6 0 0,1 10,16.5 L7.5,17.5 L5.8,14.6 L7.9,13 A7.8,7.8 0 0,1 7.9,11 L5.8,9.4 L7.5,6.5 L10,7.5 A7.6,7.6 0 0,1 11.6,6.6 L12,4 H15.3 L15.7,6.6 A7.6,7.6 0 0,1 17.3,7.5 L19.8,6.5 L21.5,9.4 L19.4,11 A7.8,7.8 0 0,1 19.4,13 Z"
                                      Stroke="#C8D0E0" StrokeThickness="1.5" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- BLOQUE CENTRAL DE INICIO -->
                        <StackPanel x:Name="WelcomeContentPanel" MaxWidth="860" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,36,0,0">
                            <StackPanel.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </StackPanel.Triggers>

                            <!-- ARAÑA GEOMÉTRICA CON SIMBOLOGÍA MATEMÁTICA (Σ, π, ∞, EJES) -->
                            <Border x:Name="WelcomeLogoContainer" Width="122" Height="122" HorizontalAlignment="Center" Margin="0,0,0,6" Background="Transparent" Cursor="Hand">
                                <Viewbox Width="118" Height="118">
                                    <Canvas Width="120" Height="120">
                                        <!-- Plano cartesiano de fondo sutil -->
                                        <Line X1="60" Y1="6" X2="60" Y2="114" Stroke="#13223D" StrokeThickness="1" StrokeDashArray="3 3"/>
                                        <Line X1="6" Y1="60" X2="114" Y2="60" Stroke="#13223D" StrokeThickness="1" StrokeDashArray="3 3"/>
                                        <Ellipse Canvas.Left="10" Canvas.Top="10" Width="100" Height="100" Stroke="#193361" StrokeThickness="1.2" StrokeDashArray="6 4"/>

                                        <!-- 8 PATAS DE ARAÑA ARTICULADAS EN DOBLE QUIEBRE -->
                                        <!-- Izquierda 1 (frontal) -->
                                        <Path Data="M53,46 L34,24 L17,12" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <!-- Izquierda 2 -->
                                        <Path Data="M50,53 L26,38 L7,31" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <!-- Izquierda 3 -->
                                        <Path Data="M50,62 L24,62 L5,68" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <!-- Izquierda 4 (trasera) -->
                                        <Path Data="M53,70 L33,89 L18,106" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

                                        <!-- Derecha 1 (frontal) -->
                                        <Path Data="M67,46 L86,24 L103,12" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <!-- Derecha 2 -->
                                        <Path Data="M70,53 L94,38 L113,31" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <!-- Derecha 3 -->
                                        <Path Data="M70,62 L96,62 L115,68" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <!-- Derecha 4 (trasera) -->
                                        <Path Data="M67,70 L87,89 L102,106" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

                                        <!-- Articulaciones con puntos de precisión -->
                                        <Ellipse Canvas.Left="31.5" Canvas.Top="21.5" Width="5" Height="5" Fill="#93C5FD"/>
                                        <Ellipse Canvas.Left="83.5" Canvas.Top="21.5" Width="5" Height="5" Fill="#93C5FD"/>
                                        <Ellipse Canvas.Left="23.5" Canvas.Top="35.5" Width="5" Height="5" Fill="#93C5FD"/>
                                        <Ellipse Canvas.Left="91.5" Canvas.Top="35.5" Width="5" Height="5" Fill="#93C5FD"/>
                                        <Ellipse Canvas.Left="21.5" Canvas.Top="59.5" Width="5" Height="5" Fill="#93C5FD"/>
                                        <Ellipse Canvas.Left="93.5" Canvas.Top="59.5" Width="5" Height="5" Fill="#93C5FD"/>
                                        <Ellipse Canvas.Left="30.5" Canvas.Top="86.5" Width="5" Height="5" Fill="#93C5FD"/>
                                        <Ellipse Canvas.Left="84.5" Canvas.Top="86.5" Width="5" Height="5" Fill="#93C5FD"/>

                                        <!-- Cefalotórax superior con símbolo π -->
                                        <Polygon Points="60,26 71,38 60,48 49,38" Fill="#FFFFFF"/>
                                        <TextBlock Canvas.Left="55.5" Canvas.Top="30.5" Text="π" FontSize="12" FontWeight="Bold" Foreground="#0B1933"/>

                                        <!-- Abdomen alargado de araña con símbolo Σ e ∞ -->
                                        <Polygon Points="60,48 73,68 60,96 47,68" Fill="#0D2142" Stroke="#FFFFFF" StrokeThickness="2.4" StrokeLineJoin="Round"/>
                                        <TextBlock Canvas.Left="54.8" Canvas.Top="52" Text="Σ" FontSize="13" FontWeight="Bold" Foreground="#60A5FA"/>
                                        <TextBlock Canvas.Left="53.5" Canvas.Top="69" Text="∞" FontSize="14" FontWeight="Bold" Foreground="#93C5FD"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <TextBlock Text="Archon" FontSize="44" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,2"/>

                            <TextBlock x:Name="TxtWelcomeSubtitle" Text="Welcome" FontSize="17.5" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,0,0,26"/>

                            <!-- 3 BOTONES PRINCIPALES -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                                <Button x:Name="BtnStartStepZero" Style="{StaticResource PrimaryButtonStyle}" Padding="30,14" Margin="0,0,12,0" Click="BtnStartStepZero_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtStartButtonLabel" Text="Get Started" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="10,1,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnScanHardware" Style="{StaticResource SoftCardButtonStyle}" Padding="22,14" Margin="0,0,12,0" Click="BtnScanHardware_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M9,2 V5 M15,2 V5 M9,19 V22 M15,19 V22 M2,9 H5 M2,15 H5 M19,9 H22 M19,15 H22 M6,5 H18 A1,1 0 0 1 19,6 V18 A1,1 0 0 1 18,19 H6 A1,1 0 0 1 5,18 V6 A1,1 0 0 1 6,5 Z M9,9 H15 V15 H9 Z"
                                              Stroke="#E2E5F0" StrokeThickness="1.7" Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtScanButtonLabel" Text="View my components" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnOpenPerformance" Style="{StaticResource SoftCardButtonStyle}" Padding="22,14" Click="BtnOpenPerformance_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M3,13 H7 L10,5 L14,19 L17,11 H21"
                                              Stroke="#5D9BE6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtPerformanceButtonLabel" Text="Performance" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- RESUMEN INSTANTÁNEO DE COMPONENTES -->
                            <Border x:Name="HardwareListPanel" Visibility="Collapsed" MinWidth="680" Background="#CC090A0F"
                                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="26,22">
                                <StackPanel>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" x:Name="TxtDetectedComponentsTitle" Text="Detected components" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                        <Button Grid.Column="1" x:Name="BtnViewAllHardware" Style="{StaticResource GhostButtonStyle}" Padding="10,5" Click="BtnViewAllHardware_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtSeeMoreLabel" Text="See more" FontSize="14.5" FontWeight="SemiBold" Foreground="#5D9BE6" VerticalAlignment="Center"/>
                                                <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#5D9BE6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" Margin="6,1,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtLblCpu" Text="Processor" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtCpuValue" Text="Detecting..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtLblMother" Text="Motherboard" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtMotherValue" Text="Detecting..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtLblGpu" Text="Graphics card" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtGpuValue" Text="Detecting..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtLblRam" Text="Memory RAM" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtRamValue" Text="Detecting..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtLblStorage" Text="Storage" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtStorageValue" Text="Detecting..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Separator Background="#1B1E2B" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxtLblOs" Text="Operating system" FontSize="15" FontWeight="Medium" Foreground="#CBD2E3" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtOsValue" Text="Detecting..." FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- VISTA 1B: ESPECIFICACIONES COMPLETAS DEL SISTEMA CON CARGA AL TOCAR VER MÁS -->
                <ScrollViewer x:Name="FullHardwareView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FullHardwareContainer" Width="1100" HorizontalAlignment="Center" Margin="28,18,28,48">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="FullHardwareSlideTransform" Y="0"/>
                        </StackPanel.RenderTransform>

                        <Button x:Name="BtnBackFromFullHardware" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="-10,0,0,14" Click="BtnBackFromFullHardware_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19,12 L5,12 M11,6 L5,12 L11,18"
                                      Stroke="#E4E7F2" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBackHomeLabel" Text="Back to home" FontSize="15" FontWeight="Medium" Foreground="#EEF1FA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="TxtFullSpecsTitle" Text="Full system specifications" FontSize="29" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,22"/>

                        <!-- CARGA AL ENTRAR A VER MÁS -->
                        <Border x:Name="FullHardwareLoadingPanel" Visibility="Collapsed" Background="#D9090A0F"
                                BorderBrush="#24334F" BorderThickness="1" CornerRadius="8" Padding="32,28" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Grid Width="36" Height="36" Margin="0,0,16,0">
                                    <Ellipse Width="36" Height="36" Stroke="#1B2840" StrokeThickness="2.5"/>
                                    <Path Data="M18,2 A16,16 0 0,1 34,18" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="DeepScanSpinnerRotate" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtDeepScanTitle" Text="Loading advanced system specifications..." FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="TxtDeepScanSub" Text="Querying CPU architecture, BIOS, memory slots, drives, network adapters and OS details..." FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="FullHardwareSectionsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#D9090A0F" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="26,20" Margin="0,0,0,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                <Border Width="4" Height="18" CornerRadius="2" Background="#3B82F6" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SectionTitle}" FontSize="18.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Specs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#161924" BorderThickness="0,0,0,1" Padding="0,12">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="320"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="16" FontWeight="Medium" Foreground="#CED5E6" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="16.5" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- VISTA 1D: MI PERFIL Y CONFIGURACIÓN GENERAL -->
                <ScrollViewer x:Name="SettingsAndProfileView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Width="1060" HorizontalAlignment="Center" Margin="28,18,28,48">
                        <Button x:Name="BtnBackFromSettings" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="-10,0,0,14" Click="BtnBackFromSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19,12 L5,12 M11,6 L5,12 L11,18"
                                      Stroke="#E4E7F2" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtBackFromSettingsLabel" Text="Back to home" FontSize="15" FontWeight="Medium" Foreground="#EEF1FA" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- PESTAÑAS INTERNAS: MI PERFIL / CONFIGURACIÓN GENERAL -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <Button x:Name="BtnSubTabProfile" Content="My Profile" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="BtnSubTabProfile_Click"/>
                            <Button x:Name="BtnSubTabGeneral" Content="General Settings" Style="{StaticResource SoftCardButtonStyle}" Click="BtnSubTabGeneral_Click"/>
                        </StackPanel>

                        <!-- SUBVISTA PERFIL -->
                        <Border x:Name="SubPanelProfile" Background="#D9090A0F" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="28,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,32,0">
                                    <Border Width="104" Height="104" CornerRadius="52" Background="#101829" BorderBrush="#3B82F6" BorderThickness="2" Margin="0,0,0,14">
                                        <Grid>
                                            <Ellipse Margin="3">
                                                <Ellipse.Fill>
                                                    <ImageBrush x:Name="ProfilePageAvatarBrush" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock x:Name="ProfilePageAvatarInitial" Text="A" FontSize="36" FontWeight="Bold" Foreground="#60A5FA"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="BtnChooseAvatarPhoto" Content="Load photo" Style="{StaticResource SoftCardButtonStyle}" Padding="14,8" FontSize="13" Click="BtnChooseAvatarPhoto_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtProfileSectionTitle" Text="Account &amp; Identity" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14"/>
                                    <TextBlock x:Name="TxtProfileNameLabel" Text="Display name" FontSize="13.5" Foreground="#A6ACBE" Margin="0,0,0,6"/>
                                    <Border Background="#07080C" BorderBrush="#1F2433" BorderThickness="1" CornerRadius="6" MaxWidth="380" HorizontalAlignment="Left" Margin="0,0,0,16">
                                        <TextBox x:Name="TxtProfileDisplayName" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                                 BorderThickness="0" Padding="12,10" FontSize="14.5"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnSaveProfileChanges" Content="Save profile" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0" Click="BtnSaveProfileChanges_Click"/>
                                        <Button x:Name="BtnSignOutProfile" Content="Sign out" Style="{StaticResource SoftCardButtonStyle}" Click="BtnAccountSignOut_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtProfileFeedback" Text="" FontSize="13.5" Foreground="#4CC38A" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- SUBVISTA CONFIGURACIÓN GENERAL -->
                        <StackPanel x:Name="SubPanelGeneral" Visibility="Collapsed">
                            <Border Background="#D9090A0F" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="24,20" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtGenBlockTitle" Text="General &amp; Interface" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,14">
                                        <TextBlock x:Name="TxtOptNotifications" Text="Desktop notifications for completed tasks" FontSize="15" Foreground="#E4E8F2" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ChkOptNotifications" Style="{StaticResource ModernSwitchStyle}" IsChecked="True" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <TextBlock x:Name="TxtOptExperimental" Text="Enable experimental features &amp; preview telemetry" FontSize="15" Foreground="#E4E8F2" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ChkOptExperimental" Style="{StaticResource ModernSwitchStyle}" IsChecked="False" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <TextBlock x:Name="TxtOptAnalytics" Text="Anonymous diagnostic &amp; performance analytics" FontSize="15" Foreground="#E4E8F2" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ChkOptAnalytics" Style="{StaticResource ModernSwitchStyle}" IsChecked="True" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#D9090A0F" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="24,20">
                                <StackPanel>
                                    <TextBlock x:Name="TxtGenSystemBlockTitle" Text="Updates, Feedback &amp; About" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnCheckUpdates" Content="Check for updates" Style="{StaticResource SoftCardButtonStyle}" Margin="0,0,10,0" Click="BtnSettingsAction_Click"/>
                                        <Button x:Name="BtnShareFeedback" Content="Share / Feedback" Style="{StaticResource SoftCardButtonStyle}" Margin="0,0,10,0" Click="BtnSettingsAction_Click"/>
                                        <Button x:Name="BtnResetSettings" Content="Reset settings" Style="{StaticResource SoftCardButtonStyle}" Margin="0,0,10,0" Click="BtnResetSettings_Click"/>
                                        <Button x:Name="BtnAboutArchon" Content="About Archon" Style="{StaticResource SoftCardButtonStyle}" Click="BtnSettingsAction_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtSettingsStatusMsg" Text="" FontSize="13.5" Foreground="#60A5FA" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- VISTA 1C: RENDIMIENTO EN TIEMPO REAL (DISEÑO FLUIDO SIN CAJITAS) -->
                <ScrollViewer x:Name="PerformanceView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Width="1140" HorizontalAlignment="Center" Margin="28,16,28,44">
                        <Grid Margin="0,0,0,12">
                            <Button x:Name="BtnBackFromPerformance" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="-10,0,0,0" Click="BtnBackFromPerformance_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19,12 L5,12 M11,6 L5,12 L11,18"
                                          Stroke="#E4E7F2" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPerfBackLabel" Text="Back to home" FontSize="15" FontWeight="Medium" Foreground="#EEF1FA" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPerfLiveBadge" Text="LIVE TELEMETRY · 1.0s" FontSize="12.5" FontWeight="SemiBold" Foreground="#93C5FD"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TxtPerfTitle" Text="Real-time hardware performance" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtPerfSubtitle" Text="Continuous system telemetry across processor, graphics, memory, storage and network." FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,18"/>

                        <!-- GRÁFICO PANORÁMICO SUPERIOR ABIERTO -->
                        <Grid Margin="0,0,0,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="130"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtPerfOverviewTitle" Text="SYSTEM LOAD CURVE" FontSize="12" FontWeight="Bold" Foreground="#5D9BE6" Margin="0,0,18,0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                        <Ellipse Width="8" Height="8" Fill="#3B82F6" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="CPU" FontSize="12" Foreground="#C8D0E0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="GPU" FontSize="12" Foreground="#C8D0E0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#A78BFA" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="RAM" FontSize="12" Foreground="#C8D0E0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="TxtPerfOverviewSummary" Text="CPU 0% · GPU 0% · RAM 0%" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E8F2" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Grid.Row="1" x:Name="PerfOverviewGraphHost">
                                <Line X1="0" Y1="32" X2="1140" Y2="32" Stroke="#141C2E" StrokeThickness="1" StrokeDashArray="4 4"/>
                                <Line X1="0" Y1="65" X2="1140" Y2="65" Stroke="#141C2E" StrokeThickness="1" StrokeDashArray="4 4"/>
                                <Line X1="0" Y1="98" X2="1140" Y2="98" Stroke="#141C2E" StrokeThickness="1" StrokeDashArray="4 4"/>
                                <Polyline x:Name="PerfRamSparkline" Stroke="#A78BFA" StrokeThickness="2" StrokeLineJoin="Round"/>
                                <Polyline x:Name="PerfGpuSparkline" Stroke="#10B981" StrokeThickness="2.2" StrokeLineJoin="Round"/>
                                <Polyline x:Name="PerfCpuSparkline" Stroke="#3B82F6" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                            </Grid>
                        </Grid>

                        <Separator Background="#1B2233" Margin="0,0,0,6"/>

                        <!-- FILA 1: CPU -->
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="#0C1526" BorderBrush="#3B82F6" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPerfCpuPct" Text="0%" FontSize="17" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="TxtPerfCpuHeader" Text="PROCESSOR" FontSize="11.5" FontWeight="Bold" Foreground="#5D9BE6"/>
                                <TextBlock x:Name="TxtPerfCpuModel" Text="Detecting CPU..." FontSize="14.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtPerfCpuCores" Text="Threads: --" FontSize="12" Foreground="#8C97AD"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                                <ProgressBar x:Name="PerfCpuBar" Minimum="0" Maximum="100" Value="0" Height="6" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtPerfCpuTemp" Text="Temp: -- °C" FontSize="13" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,22,0"/>
                                    <TextBlock x:Name="TxtPerfCpuClock" Text="Clock: -- MHz" FontSize="13" Foreground="#D4D6E0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="3" Height="50" Background="#070A12" BorderBrush="#161E30" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid x:Name="PerfCpuMiniHost">
                                    <Polyline x:Name="PerfCpuMiniLine" Stroke="#3B82F6" StrokeThickness="2" StrokeLineJoin="Round"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Separator Background="#141A26"/>

                        <!-- FILA 2: GPU -->
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="#0A1D18" BorderBrush="#10B981" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPerfGpuPct" Text="0%" FontSize="17" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="TxtPerfGpuHeader" Text="GRAPHICS" FontSize="11.5" FontWeight="Bold" Foreground="#34D399"/>
                                <TextBlock x:Name="TxtPerfGpuModel" Text="Detecting GPU..." FontSize="14.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtPerfGpuDriver" Text="Driver: --" FontSize="12" Foreground="#8C97AD"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                                <ProgressBar x:Name="PerfGpuBar" Foreground="#10B981" Minimum="0" Maximum="100" Value="0" Height="6" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtPerfGpuTemp" Text="Temp: -- °C" FontSize="13" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,22,0"/>
                                    <TextBlock x:Name="TxtPerfGpuVram" Text="VRAM: --" FontSize="13" Foreground="#D4D6E0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="3" Height="50" Background="#070A12" BorderBrush="#161E30" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid x:Name="PerfGpuMiniHost">
                                    <Polyline x:Name="PerfGpuMiniLine" Stroke="#10B981" StrokeThickness="2" StrokeLineJoin="Round"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Separator Background="#141A26"/>

                        <!-- FILA 3: RAM -->
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="#140F26" BorderBrush="#A78BFA" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPerfRamPct" Text="0%" FontSize="17" FontWeight="Bold" Foreground="#C4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="TxtPerfRamHeader" Text="MEMORY RAM" FontSize="11.5" FontWeight="Bold" Foreground="#A78BFA"/>
                                <TextBlock x:Name="TxtPerfRamUsed" Text="0.0 / 0.0 GB" FontSize="14.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtPerfRamSpeed" Text="Speed: --" FontSize="12" Foreground="#8C97AD"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                                <ProgressBar x:Name="PerfRamBar" Foreground="#A78BFA" Minimum="0" Maximum="100" Value="0" Height="6" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtPerfRamDetail" Text="Physical memory allocation" FontSize="13" Foreground="#D4D6E0"/>
                            </StackPanel>

                            <Border Grid.Column="3" Height="50" Background="#070A12" BorderBrush="#161E30" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid x:Name="PerfRamMiniHost">
                                    <Polyline x:Name="PerfRamMiniLine" Stroke="#A78BFA" StrokeThickness="2" StrokeLineJoin="Round"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Separator Background="#141A26"/>

                        <!-- FILA 4: ALMACENAMIENTO Y RED -->
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="#1F1608" BorderBrush="#F59E0B" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtPerfDiskPct" Text="0%" FontSize="17" FontWeight="Bold" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="TxtPerfDiskHeader" Text="STORAGE &amp; NETWORK" FontSize="11.5" FontWeight="Bold" Foreground="#FBBF24"/>
                                <TextBlock x:Name="TxtPerfDiskModel" Text="Primary Disk" FontSize="14.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtPerfNetAdapter" Text="Adapter: --" FontSize="12" Foreground="#8C97AD" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock x:Name="TxtPerfDiskRate" Text="Disk R/W: 0.0 MB/s" FontSize="13.5" FontWeight="SemiBold" Foreground="#FBBF24" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtPerfNetDown" Text="↓ Down: 0 KB/s" FontSize="13" Foreground="#38BDF8" Margin="0,0,20,0"/>
                                    <TextBlock x:Name="TxtPerfNetUp" Text="↑ Up: 0 KB/s" FontSize="13" Foreground="#93C5FD"/>
                                    <TextBlock x:Name="TxtPerfNetSpeedTag" Text="0 KB/s" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="3" Height="50" Background="#070A12" BorderBrush="#161E30" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid x:Name="PerfDiskMiniHost">
                                    <Polyline x:Name="PerfDiskSparkline" Stroke="#F59E0B" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                    <Polyline x:Name="PerfNetSparkline" Stroke="#38BDF8" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- VISTA 2: PREPARACIÓN DEL SISTEMA CON ENTRADA SUAVE ESCALONADA -->
                <ScrollViewer x:Name="StepZeroView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Effect>
                        <BlurEffect x:Name="StepZeroBlur" Radius="0"/>
                    </ScrollViewer.Effect>

                    <StackPanel Width="1080" HorizontalAlignment="Center" Margin="28,18,28,48">

                        <StackPanel x:Name="StepZeroHeaderBlock">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="StepZeroHeaderTransform" Y="0"/>
                            </StackPanel.RenderTransform>

                            <Button x:Name="BtnBackToWelcome" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="-10,0,0,14" Click="BtnBackToWelcome_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,10.5 L12,3 L21,10.5 V20 A1,1 0 0 1 20,21 H15 V14 H9 V21 H4 A1,1 0 0 1 3,20 Z"
                                          Stroke="#D0D0DA" StrokeThickness="1.7" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtHomeNavLabel" Text="Home" FontSize="14.5" FontWeight="Medium" Foreground="#E4E4EC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="TxtPrepTitle" Text="System preparation" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>

                            <TextBlock x:Name="TxtPrepSubtitle" Text="Choose your current Windows state to prepare drivers before entering the optimization panel."
                                       FontSize="16" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,24"/>
                        </StackPanel>

                        <Border x:Name="BloatAlertBox" Visibility="Collapsed" Background="#0C111C" BorderBrush="#23334F" BorderThickness="1" CornerRadius="6" Padding="20,14" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,3 L22,20 H2 Z M12,9 V13 M12,17 H12.01" Stroke="#5D9BE6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,1,12,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock x:Name="TxtBloatTitle" Text="OEM additional software detected" FontSize="14.5" FontWeight="SemiBold" Foreground="#5D9BE6" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtDetectedBloatList" Text="" FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnFreshInstall" Style="{StaticResource PrepOptionButtonStyle}" Margin="0,0,0,0" Click="BtnFreshInstall_Click">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="FreshInstallTransform" Y="0"/>
                            </Button.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                    <TextBlock x:Name="TxtFreshTitle" Text="Fresh Windows installation" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtFreshDesc" Text="Creates a preventive restore point and installs only essential drivers without telemetry or extra panels."
                                               FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtFreshAction" Text="Install" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,8,0"/>
                                    <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#3474C6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Border x:Name="ProgressPanelFresh" Visibility="Collapsed" Background="#07080C" BorderBrush="#1C1E28" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="28,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TxtStatusFresh" Text="Completed" FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtPercentFresh" Text="100%" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Grid>
                                <ProgressBar x:Name="ProgressFresh" Minimum="0" Maximum="100" Value="0"/>
                            </StackPanel>
                        </Border>

                        <Border Height="14"/>

                        <Button x:Name="BtnCleanAndInstall" Style="{StaticResource PrepOptionButtonStyle}" Margin="0,0,0,0" Click="BtnCleanAndInstall_Click">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="CleanInstallTransform" Y="0"/>
                            </Button.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                    <TextBlock x:Name="TxtCleanTitle" Text="I already installed drivers or OEM utilities" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtCleanDesc" Text="Removes previous drivers and suites like Armoury Crate or GeForce Experience, reboots, and leaves a clean base."
                                               FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCleanAction" Text="Clean" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,8,0"/>
                                    <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#3474C6" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Border x:Name="ProgressPanelClean" Visibility="Collapsed" Background="#07080C" BorderBrush="#1C1E28" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="28,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TxtStatusClean" Text="Completed" FontSize="14" Foreground="#E4E4EC" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtPercentClean" Text="100%" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Grid>
                                <ProgressBar x:Name="ProgressClean" Minimum="0" Maximum="100" Value="0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="StepZeroSkipSection">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="SkipSectionTransform" Y="0"/>
                            </StackPanel.RenderTransform>

                            <Separator Background="#1C1E28" Margin="0,28,0,22"/>

                            <TextBlock x:Name="TxtAlreadyReadyPrompt" Text="Already have clean, configured drivers?"
                                       FontSize="15.5" FontWeight="Medium" Foreground="#E4E4EC" Margin="2,0,0,12"/>

                            <Button x:Name="BtnSkipDrivers" Style="{StaticResource PrepOptionButtonStyle}" Click="BtnSkipDrivers_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                        <TextBlock x:Name="TxtSkipTitle" Text="My drivers are already ready" FontSize="17.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="TxtSkipDesc" Text="Creates the mandatory preventive restore point and jumps straight into the system optimization panel."
                                                   FontSize="15" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSkipAction" Text="Continue" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0" Margin="0,0,8,0"/>
                                        <Path Data="M5,12 L19,12 M13,6 L19,12 L13,18" Stroke="#3474C6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="StepZeroWhySection">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="WhySectionTransform" Y="0"/>
                            </StackPanel.RenderTransform>

                            <Separator Background="#1C1E28" Margin="0,32,0,26"/>

                            <TextBlock x:Name="TxtWhyTitle" Text="Why do we perform this step?" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="M12,2 L20,6 V12 C20,17.5 16.5,21.5 12,23 C7.5,21.5 4,17.5 4,12 V6 L12,2 Z"
                                              Stroke="#3474C6" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtWhy1Title" Text="Preventive backup" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtWhy1Desc" Text="Saves an exact snapshot of Windows before modifying any setting. Zero performance impact and uses at most 5% disk space."
                                               FontSize="14.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="M4,6 H20 V18 H4 Z M8,2 V6 M16,2 V6"
                                              Stroke="#3474C6" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtWhy2Title" Text="Bloat-free drivers" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtWhy2Desc" Text="Prevents Windows Update from pushing generic packages and prepares Chipset and GPU without background services."
                                               FontSize="14.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z"
                                              Stroke="#3474C6" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtWhy3Title" Text="Reversible tweaks" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtWhy3Desc" Text="Every adjustment lets you review its purpose and restore Windows defaults in a single click."
                                               FontSize="14.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="22"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- VISTA 3: PANEL DE SCRIPTS / AJUSTES (SIN CAJITAS ARRIBA Y CON LOGOS REALES) -->
                <Grid x:Name="MainOptimizerView" Visibility="Collapsed" Margin="26,18,22,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="244"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- MENÚ LATERAL -->
                    <DockPanel Grid.Column="0" Margin="0,0,24,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Separator Background="#1B2233" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnOpenMyProfile_Click">
                                    <Border Width="38" Height="38" CornerRadius="19" Background="#101829" BorderBrush="#3B82F6" BorderThickness="1.6">
                                        <Grid>
                                            <Ellipse Margin="2">
                                                <Ellipse.Fill>
                                                    <ImageBrush x:Name="SidebarAvatarBrush" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock x:Name="SidebarAvatarInitial" Text="A" FontSize="14" FontWeight="Bold" Foreground="#60A5FA"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Button>

                                <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtSidebarUser" Text="Agustín" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" MaxWidth="126" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtSidebarUserStatus" Text="Active profile" FontSize="11.5" Foreground="#8C97AD"/>
                                </StackPanel>

                                <Button Style="{StaticResource GhostButtonStyle}" Padding="6" VerticalAlignment="Center" Click="BtnOpenGeneralSettings_Click">
                                    <Path Data="M12,8.5 A3.5,3.5 0 1,0 15.5,12 A3.5,3.5 0 0,0 12,8.5 Z M19.4,13 L21.5,14.6 L19.8,17.5 L17.3,16.5 A7.6,7.6 0 0,1 15.7,17.4 L15.3,20 H12 L11.6,17.4 A7.6,7.6 0 0,1 10,16.5 L7.5,17.5 L5.8,14.6 L7.9,13 A7.8,7.8 0 0,1 7.9,11 L5.8,9.4 L7.5,6.5 L10,7.5 A7.6,7.6 0 0,1 11.6,6.6 L12,4 H15.3 L15.7,6.6 A7.6,7.6 0 0,1 17.3,7.5 L19.8,6.5 L21.5,9.4 L19.4,11 A7.8,7.8 0 0,1 19.4,13 Z"
                                          Stroke="#A6ACBE" StrokeThickness="1.5" Width="15" Height="15" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="SidebarMenu">
                            <Button x:Name="BtnBackToStepZero" Style="{StaticResource GhostButtonStyle}"
                                    HorizontalContentAlignment="Left" Margin="0,0,0,6" Click="BtnBackToStepZero_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,10.5 L12,3 L21,10.5 V20 H15 V14 H9 V20 H3 Z" Stroke="#D0D0DA" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="TxtNavPrep" Text="Preparation" FontWeight="SemiBold" Foreground="#E4E4EC"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnSidebarPerf" Style="{StaticResource GhostButtonStyle}"
                                    HorizontalContentAlignment="Left" Margin="0,0,0,14" Click="BtnOpenPerformance_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,13 H7 L10,5 L14,19 L17,11 H21" Stroke="#5D9BE6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="TxtNavPerf" Text="Performance" FontWeight="SemiBold" Foreground="#93C5FD"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnCatApps" Content="Apps" Tag="Apps" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                            <Button x:Name="BtnCatGaming" Content="Gaming &amp; Power" Tag="Gaming y Energía" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                            <Button x:Name="BtnCatNetwork" Content="Network &amp; DNS" Tag="Red y DNS" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                            <Button x:Name="BtnCatDebloat" Content="Debloat" Tag="Debloat" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                            <Button x:Name="BtnCatServices" Content="Services" Tag="Servicios" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                            <Button x:Name="BtnCatCleanup" Content="Cleanup" Tag="Limpieza" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,7" Click="CategoryBtn_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- CONTENIDO CENTRAL -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- LÍNEA DE TELEMETRÍA LIMPIA EN LÍNEA (SIN CAJITAS RECTANGULARES) -->
                        <Grid Grid.Row="0" Margin="4,0,22,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtOptStatCpuLabel" Text="CPU " FontSize="12.5" FontWeight="SemiBold" Foreground="#8C97AD"/>
                                <TextBlock x:Name="TxtOptStatCpuVal" Text="0%" FontSize="13.5" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,8,0"/>
                                <ProgressBar x:Name="OptStatCpuBar" Minimum="0" Maximum="100" Value="0" Width="64" Height="5" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtOptStatRamLabel" Text="RAM " FontSize="12.5" FontWeight="SemiBold" Foreground="#8C97AD"/>
                                <TextBlock x:Name="TxtOptStatRamVal" Text="0.0 / 0.0 GB" FontSize="13.5" FontWeight="Bold" Foreground="#C4B5FD" Margin="0,0,8,0"/>
                                <ProgressBar x:Name="OptStatRamBar" Foreground="#A78BFA" Minimum="0" Maximum="100" Value="0" Width="64" Height="5" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="3" x:Name="TxtOptStatSelVal" Text="0 selected" FontSize="13.5" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtOptStatBackupVal" Text="VSS Protected" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtOptStatSelLabel" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtOptStatBackupLabel" Visibility="Collapsed"/>
                        </Grid>

                        <!-- BUSCADOR -->
                        <Border Grid.Row="1" Background="#CC090A0F" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,22,14">
                            <Grid>
                                <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="#FFFFFF"
                                         CaretBrush="#FFFFFF" BorderThickness="0"
                                         Padding="16,12" FontSize="15" TextChanged="TxtSearch_TextChanged"/>
                                <TextBlock x:Name="TxtSearchPlaceholder" Text="Search tweak or application..." Foreground="{StaticResource TextMuted}" FontSize="15"
                                           Margin="17,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- LISTA AGRUPADA CON LOGOS REALES DE APLICACIONES -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                            <ItemsControl x:Name="TweaksItemsControl">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,10,0,10">
                                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="#98A9C7"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Margin" Value="0,0,0,12"/>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#D9090A0F" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,9">
                                            <StackPanel>
                                                <Grid Margin="20,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"
                                                            Width="38" Height="38" CornerRadius="8" Background="#0D111A" BorderBrush="#1F2638" BorderThickness="1"
                                                            Margin="0,0,15,0" VerticalAlignment="Center">
                                                        <Image Source="{Binding IconUrl}" Width="24" Height="24" Stretch="Uniform"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15.5" FontWeight="Medium" Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                    <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Padding="10,6" Margin="10,0" Tag="{Binding}" Click="BtnInfo_Click">
                                                        <TextBlock Text="ⓘ" FontSize="16" Foreground="#A6ACBE"/>
                                                    </Button>

                                                    <CheckBox Grid.Column="3" Style="{StaticResource ModernSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Click="TweakSwitch_Click"/>
                                                </Grid>

                                                <Border Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVis}}"
                                                        Background="#0D1019" BorderBrush="#1C2334" BorderThickness="0,1,0,0"
                                                        CornerRadius="0,0,6,6" Padding="20,14">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="3" CornerRadius="1.5" Background="#3B82F6" Margin="0,2,12,2"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="14.5" Foreground="#E4E8F2" TextWrapping="Wrap" LineHeight="21"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- BARRA INFERIOR -->
                        <Grid Grid.Row="3" Margin="0,14,22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="BtnRestoreOriginal" Content="Restore defaults" Style="{StaticResource SoftCardButtonStyle}" Padding="20,12" Click="BtnRestoreAll_Click"/>
                            <TextBlock x:Name="TxtActionFeedback" Grid.Column="1" Text="" FontSize="14.5" FontWeight="SemiBold" Foreground="#4CC38A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0"/>
                            <Button Grid.Column="2" x:Name="BtnApplyChanges" Content="Apply changes" Style="{StaticResource PrimaryButtonStyle}" Padding="26,12" Click="BtnApplyChanges_Click"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- OVERLAY DE CARGA CON ARAÑA ANIMADA EN EL CENTRO (Z-INDEX 999) -->
                <Grid x:Name="PrepModalOverlay" Panel.ZIndex="999" Visibility="Collapsed" Background="#D8050609">
                    <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="124" Height="124" HorizontalAlignment="Center" Margin="0,0,0,22">
                            <Ellipse Width="124" Height="124" Stroke="#182236" StrokeThickness="2.2"/>
                            <Path Data="M62,2 A60,60 0 0,1 122,62" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="LoadingRingRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>

                            <Ellipse Width="96" Height="96" Stroke="#121A29" StrokeThickness="1.6"/>
                            <Path Data="M62,110 A48,48 0 0,1 14,62" Stroke="#255EA8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="LoadingInnerRingRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>

                            <!-- ARAÑA CON PATAS ANIMADAS DENTRO DEL CÍRCULO -->
                            <Viewbox Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="80" Height="80">
                                    <Path Data="M35,30 L20,15 L10,8 M33,38 L14,30 L4,26 M33,44 L14,48 L4,54 M35,50 L20,64 L11,74"
                                          Stroke="#60A5FA" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="LoadingSpiderLegLeftTransform" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <Path Data="M45,30 L60,15 L70,8 M47,38 L66,30 L76,26 M47,44 L66,48 L76,54 M45,50 L60,64 L69,74"
                                          Stroke="#60A5FA" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="LoadingSpiderLegRightTransform" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <Polygon Points="40,18 48,28 40,36 32,28" Fill="#FFFFFF"/>
                                    <Polygon Points="40,36 49,50 40,66 31,50" Fill="#122E59" Stroke="#FFFFFF" StrokeThickness="2"/>
                                    <TextBlock Canvas.Left="36" Canvas.Top="40" Text="Σ" FontSize="11" FontWeight="Bold" Foreground="#93C5FD"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <TextBlock x:Name="TxtModalStepTag" Text="STAGE 1 OF 3 · SYSTEM BACKUP"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#5D9BE6"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtModalTitle" Text="Preparing system"
                                   FontSize="25" FontWeight="SemiBold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock x:Name="TxtModalMessage" Text="Creating preventive system restore point..."
                                   FontSize="15.5" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,28"/>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="TxtModalProcessingLabel" Text="Processing configuration" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtModalPercent" Text="0%" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </Grid>

                        <ProgressBar x:Name="ModalProgressBar" Height="9" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>
                </Grid>

                <!-- MODAL DE CUENTA ESTÁNDAR LIMPIO (Z-INDEX 999, SIEMPRE ARRIBA) -->
                <Grid x:Name="AccountModalOverlay" Panel.ZIndex="999" Visibility="Collapsed" Background="#C8050609">
                    <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#0C0F18" BorderBrush="#26314A" BorderThickness="1" CornerRadius="10" Padding="26,22">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock x:Name="TxtAccountModalTitle" Text="Sign in to Archon" FontSize="19" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Button Content="✕" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" Padding="8,4" Click="BtnCloseAccountModal_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnTabSignIn" Content="Sign in" Style="{StaticResource PrimaryButtonStyle}" Padding="10,8" FontSize="13" Click="BtnTabSignIn_Click"/>
                                <Button Grid.Column="2" x:Name="BtnTabRegister" Content="Create account" Style="{StaticResource SoftCardButtonStyle}" Padding="10,8" FontSize="13" Click="BtnTabRegister_Click"/>
                            </Grid>

                            <TextBlock x:Name="TxtAccountUserLabel" Text="Email or username" FontSize="13" Foreground="#A6ACBE" Margin="0,0,0,6"/>
                            <Border Background="#07090F" BorderBrush="#1F2638" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
                                <TextBox x:Name="TxtAccountInput" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                         BorderThickness="0" Padding="12,10" FontSize="14"/>
                            </Border>

                            <TextBlock x:Name="TxtAccountPassLabel" Text="Password" FontSize="13" Foreground="#A6ACBE" Margin="0,0,0,6"/>
                            <Border Background="#07090F" BorderBrush="#1F2638" BorderThickness="1" CornerRadius="6" Margin="0,0,0,14">
                                <PasswordBox x:Name="TxtAccountPassInput" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                             BorderThickness="0" Padding="12,10" FontSize="14"/>
                            </Border>

                            <StackPanel x:Name="PanelRegisterExtra" Visibility="Collapsed" Margin="0,0,0,14">
                                <TextBlock x:Name="TxtAccountConfirmLabel" Text="Display name" FontSize="13" Foreground="#A6ACBE" Margin="0,0,0,6"/>
                                <Border Background="#07090F" BorderBrush="#1F2638" BorderThickness="1" CornerRadius="6">
                                    <TextBox x:Name="TxtRegisterDisplayName" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                             BorderThickness="0" Padding="12,10" FontSize="14"/>
                                </Border>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnAccountSignOut" Content="Sign out" Style="{StaticResource SoftCardButtonStyle}" Padding="12,10" Click="BtnAccountSignOut_Click"/>
                                <Button Grid.Column="2" x:Name="BtnAccountSave" Content="Continue" Style="{StaticResource PrimaryButtonStyle}" Padding="12,10" Click="BtnAccountSave_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
