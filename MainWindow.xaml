<Window x:Class="Archon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARCHON v1.0"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#07070A"
        Foreground="#F5F5F8"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0" CornerRadius="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="BgCardBlack" Color="#090A0F"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#11141E"/>
        <SolidColorBrush x:Key="BorderDark" Color="#1C1F2B"/>
        <SolidColorBrush x:Key="BorderHover" Color="#2F4263"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#1B4985"/>
        <SolidColorBrush x:Key="AccentPrimaryHover" Color="#2359A1"/>
        <SolidColorBrush x:Key="AccentLine" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#D4D6E0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A6ACBE"/>

        <!-- ILUMINACIÓN AMBIENTAL DE FONDO -->
        <Storyboard x:Key="AmbientGlowStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="AuroraTopTransform"
                             Storyboard.TargetProperty="X"
                             From="-170" To="170" Duration="0:0:11" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuroraTop"
                             Storyboard.TargetProperty="Opacity"
                             From="0.72" To="1.0" Duration="0:0:6.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="AuroraCenterTransform"
                             Storyboard.TargetProperty="Y"
                             From="-55" To="55" Duration="0:0:9" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuroraCenter"
                             Storyboard.TargetProperty="Opacity"
                             From="0.55" To="0.95" Duration="0:0:7.5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="AuroraBottomTransform"
                             Storyboard.TargetProperty="X"
                             From="160" To="-160" Duration="0:0:13" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AuroraBottom"
                             Storyboard.TargetProperty="Opacity"
                             From="0.95" To="0.60" Duration="0:0:8" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ANIMACIÓN DOBLE ANILLO PARA CARGA -->
        <Storyboard x:Key="LoadingRingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoadingRingRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:2.1"/>
            <DoubleAnimation Storyboard.TargetName="LoadingInnerRingRotate"
                             Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:3.2"/>
        </Storyboard>

        <!-- SCROLLBAR ANCHO Y SEPARADO -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,2,0,2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#282B38" CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#3D4357"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BARRA DE PROGRESO REDONDEADA -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#151822"/>
            <Setter Property="Foreground" Value="#2D6EC2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTONES DE VENTANA -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A8A8B6"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14161F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBarUtilityButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0E111A"/>
            <Setter Property="Foreground" Value="#D4D6E0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#1F2433" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#171C2B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#345080"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B82D35"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN PRINCIPAL UNIFORME (SIN LÍNEA INFERIOR RESALTADA) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="26,13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#D9194785" BorderBrush="#26599E" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EB2157A1"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#326EBD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PANEL / BOTÓN OSCURO DE SUPERFICIE -->
        <Style x:Key="SoftCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#B80B0D14"/>
            <Setter Property="Foreground" Value="#F5F5F8"/>
            <Setter Property="Padding" Value="22,15"/>
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderDark}" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D9131724"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BLOQUE DE OPCIÓN UNIFORME PARA PREPARACIÓN -->
        <Style x:Key="PrepOptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCardBlack}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="Foreground" Value="#F5F5F8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Border x:Name="LeftAccent" Width="3" HorizontalAlignment="Left" CornerRadius="6,0,0,6" Background="Transparent"/>
                                <Border Padding="28,22">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource BgCardHover}"/>
                                <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                                <Setter TargetName="LeftAccent" Property="Background" Value="#2D6EC2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RowBg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÓN DE NAVEGACIÓN DISCRETO -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#141620"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SWITCH LIMPIO -->
        <Style x:Key="ModernSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="46" Height="24" CornerRadius="5" Background="#1D1F2A">
                            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="3" Margin="3,0" HorizontalAlignment="Left" Background="#9A9AA8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentPrimary}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1A1C26" BorderThickness="1" CornerRadius="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#06070B" Offset="0"/>
                <GradientStop Color="#090D17" Offset="0.5"/>
                <GradientStop Color="#06070B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR CON EMBLEMA DE ARAÑA, IDIOMA Y USUARIO -->
            <Border Grid.Row="0" Background="#050507" BorderBrush="#12141C" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <Viewbox Width="23" Height="23" Margin="0,0,10,0">
                            <Canvas Width="64" Height="64">
                                <!-- Patas superiores -->
                                <Path Data="M26,25 L14,13 L9,5 M38,25 L50,13 L55,5" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <!-- Patas medio-superiores -->
                                <Path Data="M24,29 L9,24 L4,17 M40,29 L55,24 L60,17" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <!-- Patas medio-inferiores -->
                                <Path Data="M24,35 L9,40 L4,48 M40,35 L55,40 L60,48" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <!-- Patas inferiores -->
                                <Path Data="M26,39 L15,51 L10,59 M38,39 L49,51 L54,59" Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <!-- Cefalotórax y abdomen -->
                                <Polygon Points="32,16 38,23 32,29 26,23" Fill="#FFFFFF"/>
                                <Polygon Points="32,29 41,40 32,52 23,40" Fill="#1B4985" Stroke="#FFFFFF" StrokeThickness="2.4" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Archon" FontWeight="SemiBold" FontSize="15" Foreground="#F5F5F8" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.0" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- SELECTOR DE IDIOMA -->
                        <Button x:Name="BtnLanguageCycle" Style="{StaticResource TopBarUtilityButtonStyle}" Margin="0,0,8,0" Click="BtnLanguageCycle_Click" ToolTip="Change language / Cambiar idioma">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2 A10,10 0 1,0 22,12 A10,10 0 0,0 12,2 Z M2,12 H22 M12,2 C14.8,5 16,8.4 16,12 C16,15.6 14.8,19 12,22 C9.2,19 8,15.6 8,12 C8,8.4 9.2,5 12,2 Z"
                                      Stroke="#5D9BE6" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCurrentLangCode" Text="EN" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- BOTÓN DE CUENTA DE USUARIO -->
                        <Button x:Name="BtnUserAccount" Style="{StaticResource TopBarUtilityButtonStyle}" Margin="0,0,10,0" Click="BtnUserAccount_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,12 A4,4 0 1,0 12,4 A4,4 0 0,0 12,12 Z M4,20 C4,16.5 7.6,14.5 12,14.5 C16.4,14.5 20,16.5 20,20"
                                      Stroke="#D4D6E0" StrokeThickness="1.7" StrokeStartLineCap="Round" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTopUserLabel" Text="Account" FontWeight="Medium" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Content="—" Style="{StaticResource WindowControlButtonStyle}" Click="Minimize_Click"/>
                        <Button Content="✕" Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENEDOR PRINCIPAL -->
            <Grid Grid.Row="1">

                <!-- ILUMINACIÓN AMBIENTAL DE FONDO -->
                <Grid x:Name="AmbientGlowLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="AuroraTop" Width="1560" Height="720" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-140,-180,-140,0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AuroraTopTransform" X="0" Y="0"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.58" RadiusY="0.68">
                                <GradientStop Color="#661D57A6" Offset="0.0"/>
                                <GradientStop Color="#3B184585" Offset="0.36"/>
                                <GradientStop Color="#1611305E" Offset="0.70"/>
                                <GradientStop Color="#0011305E" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle x:Name="AuroraCenter" Width="1200" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AuroraCenterTransform" X="0" Y="0"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.52" RadiusY="0.55">
                                <GradientStop Color="#382563EB" Offset="0.0"/>
                                <GradientStop Color="#1A1B4985" Offset="0.45"/>
                                <GradientStop Color="#001B4985" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle x:Name="AuroraBottom" Width="1560" Height="700" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-140,0,-140,-210">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="AuroraBottomTransform" X="0" Y="0"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.65" GradientOrigin="0.5,0.65" RadiusX="0.60" RadiusY="0.68">
                                <GradientStop Color="#5219498A" Offset="0.0"/>
                                <GradientStop Color="#2B143A6E" Offset="0.42"/>
                                <GradientStop Color="#100F2A52" Offset="0.74"/>
                                <GradientStop Color="#000F2A52" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- VISTA 1: PRESENTACIÓN -->
                <ScrollViewer x:Name="WelcomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="WelcomeContentPanel" MaxWidth="820" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,16,32,36">
                        <StackPanel.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </StackPanel.Triggers>

                        <!-- EMBLEMA DE ARAÑA GEOMÉTRICA DE ARCHON -->
                        <Border x:Name="WelcomeLogoContainer" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,6" Background="Transparent" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Viewbox Width="92" Height="92">
                                <Canvas Width="96" Height="96">
                                    <!-- Patas delanteras -->
                                    <Path Data="M40,36 L22,19 L14,7 M56,36 L74,19 L82,7"
                                          Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <!-- Patas medio-delanteras -->
                                    <Path Data="M37,43 L15,35 L6,25 M59,43 L81,35 L90,25"
                                          Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <!-- Patas medio-traseras -->
                                    <Path Data="M37,52 L15,60 L6,72 M59,52 L81,60 L90,72"
                                          Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <!-- Patas traseras -->
                                    <Path Data="M40,59 L23,77 L15,89 M56,59 L73,77 L81,89"
                                          Stroke="#3B82F6" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

                                    <!-- Quelíceros frontales -->
