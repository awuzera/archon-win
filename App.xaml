<Application x:Class="Archon.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Paleta Cruda Negro y Rojo -->
        <SolidColorBrush x:Key="BgMainBrush" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="#161616"/>
        <SolidColorBrush x:Key="BgSubtleBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BorderGrayBrush" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="AccentRedBrush" Color="#D92323"/>
        <SolidColorBrush x:Key="AccentRedHoverBrush" Color="#F22B2B"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9A9A9A"/>

        <!-- Botón Seco con Bordes Rectos -->
        <Style x:Key="RawButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGrayBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgSubtleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Principal Rojo -->
        <Style x:Key="PrimaryRedButtonStyle" TargetType="Button" BasedOn="{StaticResource RawButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentRedHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Switch Cuadrado Crudo ON / OFF -->
        <Style x:Key="RawToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="68" Height="28" Background="#121212" BorderBrush="{StaticResource BorderGrayBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="LblOff" Text="OFF" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="LblOn" Text="ON" Foreground="{StaticResource AccentRedBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                                <Border x:Name="Thumb" Width="26" Height="22" Background="#3A3A3A" HorizontalAlignment="Left" Margin="2,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                                <Setter TargetName="Track" Property="Background" Value="#241010"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                <Setter TargetName="LblOff" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="LblOn" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
